<configuration>
  <configSections>
    <section type="NLog.Config.ConfigSectionHandler, NLog" name="nlog" />
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <nlog xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd" autoReload="true" throwExceptions="false" internalLogLevel="Off" internalLogFile="${basedir}\nlogs-internal\nlog-internal.log" xmlns="http://www.nlog-project.org/schemas/NLog.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <targets async="true">
      <target xsi:type="File" name="default" layout="${longdate} | ${level} | ${message} ${onexception:${exception:format=tostring} | ${stacktrace}}" archiveEvery="Day" archiveNumbering="Rolling" maxArchiveFiles="7" concurrentWrites="true" encoding="iso-8859-2" keepFileOpen="false" fileName="${basedir}/Logs/WebApiLog.txt" archiveFileName="${basedir}/logs/Archives/WebApiLog_{#}.txt" />
      <target xsi:type="File" name="errorLog" layout="${longdate} | ${level} | ${message} ${onexception:${exception:format=tostring} | ${stacktrace}}" archiveEvery="Day" archiveNumbering="Rolling" maxArchiveFiles="7" concurrentWrites="true" encoding="iso-8859-2" keepFileOpen="false" fileName="${basedir}/Logs/WebApiErrorLog.txt" archiveFileName="${basedir}/logs/Archives/WebApiErrorLog_{#}.txt" />
    </targets>
    <rules>
      <logger name="default" writeTo="default" minlevel="Trace" />
      <logger name="errorLog" writeTo="errorLog" minlevel="Trace" />
    </rules>
  </nlog>
