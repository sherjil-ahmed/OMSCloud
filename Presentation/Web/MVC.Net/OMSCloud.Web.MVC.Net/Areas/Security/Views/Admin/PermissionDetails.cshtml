@model OMSCloud.Web.MVC.Net.Areas.Security.Models.PERMISSION
@{
    ViewBag.Title = "Permission Details";
}

<div class="panel panel-default">
    <div class="panel-body">
        <fieldset>
            <legend>
                <h3 style="font-weight:bold; font-size:x-large">
                    Permission Details
                </h3>
            </legend>
            <div>
                <div class="form-group">
                    @Html.LabelFor(model => model.PermissionDescription, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-6">
                        @Html.EditorFor(model => model.PermissionDescription, new { htmlAttributes = new { @class = "form-control" ,@disabled = true } })
                        @Html.ValidationMessageFor(model => model.PermissionDescription, "", new { @class = "text-danger" })
                    </div>
                </div>

                <input class="btn btn-success" type="button" value="Edit Permission" onclick="location.href='@Url.Action("PermissionEdit", "Admin", new { id = Model.PermissionId })'" />
            </div>
            <br />
        </fieldset>
    </div>
</div>
<div class="panel panel-default">
    <div class="panel-body">
        <div>
            <fieldset>
                <legend>
                    <h3>
                        Roles Associated with this Permission
                    </h3>
                </legend>
                <div id="RolesTable">
                    @Html.Partial("_ListRolesTable4Permission", Model)
                </div>
            </fieldset>
        </div>
    </div>
</div>

<div>
    
    <input class="btn btn-default" type="button" value="Go to Permissions" onclick="location.href='@Url.Action("PermissionIndex", "Admin")'" />
</div>
