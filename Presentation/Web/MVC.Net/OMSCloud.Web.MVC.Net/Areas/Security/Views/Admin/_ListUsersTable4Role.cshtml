@model OMSCloud.Web.MVC.Net.Areas.Security.Models.ApplicationRole
<script type="text/javascript">
    $(document).ready(function () {
        //Unbind the original image 'href' set by the controller...
        $('.deleteUser').attr('href', 'javascript://');
        $('.deleteUser').click(function () {
            $dialog.data('id', $(this).attr('id')).data('userId', $(this).attr('userId')).dialog("open");
        });

        var $dialog = $('<div/>')
            .html("This User will be removed from the selected Role.<br/><br/>Do you wish to continue?")
            .dialog({
                autoOpen: false,
                resizable: false,
                height: 200,
                modal: true,
                title: 'Remove Role',
                buttons: [
                    {
                        text: "Continue",
                        id: "continuebtn",
                        click: function () {
                            var _userId = $(this).data('userId');
                            var _id = $(this).data('id');

                            var _parameters = { userId: _userId, id: _id };
                            $.ajax({
                                url: "/Security/Admin/DeleteUserFromRoleReturnPartialView",
                                type: "GET",
                                data: _parameters,
                                success: function (data, textStatus, jqXHR) {
                                    $('#UsersTable').html(data);
                                }
                            });
                            $(this).dialog('close');
                        }
                    },
                    {
                        text: "Cancel",
                        id: "cancelbtn",
                        click: function () {
                            $(this).dialog("close");
                        }
                    }]
            });
    });
</script>

@{if (Model.Users.Count == 0)
    {
        <h2><font color="red">No Associated Users...</font></h2>
        <br />
    }
    else
    {
        <table class="table table-striped table-hover table-bordered table-responsive dataTable" id="UserTable" style="width: 100%">
            <thead>
                <tr>
                    <th style="width:90%">
                        User
                    </th>
                    <th>
                        Action
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users.OrderBy(u => u.UserId))
                {
                    <tr>
                        <td>
                            @Html.ActionLink(user.UserId.ToString() + User.Identity.Name.ToString(), "UserDetails", new { id = user.UserId })
                        </td>
                        <td>
                            <center>
                                <a href="@Url.Action("DeleteUser", "Admin", new { id = Model.Id, userId = user.UserId })" class="deleteUser" id=@Model.Id userid=@user.UserId>
                                    <img src="@Url.Content("~/Areas/Security/Content/Images/bin.png")" />
                                </a>
                            </center>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <br />
    }
}

