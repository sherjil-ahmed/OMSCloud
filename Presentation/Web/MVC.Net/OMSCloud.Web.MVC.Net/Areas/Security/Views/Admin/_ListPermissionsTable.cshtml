
@model IEnumerable<OMSCloud.Web.MVC.Net.Areas.Security.Models.PERMISSION>
<script type="text/javascript">
	$(document).ready(function () {
		//Unbind the original image 'href' set by the controller...
		$('.deletePermission').attr('href', 'javascript://');
		$('.deletePermission').click(function () {
			$dialog.data('id', $(this).attr('id')).data('Id', $(this).attr('Id')).dialog("open");
		});

		var $dialog = $('<div/>')
		.html("Warning: This will permanently delete the Permission from the System and remove the Permission from any assoicated Roles.<br/><br/>Do you wish to continue?")
		.dialog({
			autoOpen: false,
			resizable: false,
			height: 250,
			modal: true,
			title: 'Delete Permission',
			buttons: [
						{
							text: "Continue",
							id: "continuebtn",
							click: function () {
								var _id = $(this).data('Id');
								var _parameters = { id: _id };
								$.ajax({
								    url: "/Security/Admin/DeletePermissionReturnPartialView",
									type: "GET",
									data: _parameters,
									success: function (data, textStatus, jqXHR) {
										$('#PermissionTable').html(data);
									}
								});
								$(this).dialog('close');
							}
						},
						{
							text: "Cancel",
							id: "cancelbtn",
							click: function () {
								$(this).dialog("close");
							}
						}]
		});
	});
</script>
<table class="table table-striped table-hover table-bordered table-responsive dataTable" id="PermissionTable" style="width: 100%">
	<thead>
        <tr>
            <td>
                Permission
            </td>
            <td style="width: 8%">
                Action
            </td>
        </tr>
	</thead>
    <tbody>
        @{
            if (Model != null)
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.ActionLink(item.PermissionDescription, "PermissionDetails", new { id = item.PermissionId })
                        </td>
                        <td>
                            <center>
                                <a href="@Url.Action("PermissionEdit", "Admin", new { id = item.PermissionId })">
                                    <img src="@Url.Content("~/Areas/Security/Content/Images/pen.png")" alt="Edit Permission" />
                                </a>
                                <img class="deletePermission" id="@item.PermissionId" src="@Url.Content("~/Areas/Security/Content/Images/bin.png")" style="float: centre" />
                            </center>
                        </td>
                    </tr>
                }
            }
        }
    </tbody>
</table>
