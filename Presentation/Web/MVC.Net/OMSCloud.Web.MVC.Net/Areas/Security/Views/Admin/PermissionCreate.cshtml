@model OMSCloud.Web.MVC.Net.Areas.Security.Models.PERMISSION
@{
    ViewBag.Title = "Create New Permission";
}
<script type="text/javascript">

</script>

<div class="panel panel-default">
    <div class="panel-body">
        <fieldset>
            <legend>
                <h3 style="font-weight:bold; font-size:x-large">
                    Create Permission
                </h3>
            </legend>
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true)
                <div class="form-group">
                    @Html.LabelFor(model => model.PermissionDescription, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-6">
                        @Html.EditorFor(model => model.PermissionDescription, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.PermissionDescription, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-md-offset-2 col-md-6">
                        <input type="submit" value="Create New Permission" class="btn btn-success" />
                    </div>
                </div>
            }
        </fieldset>
    </div>
</div>
<div>
    <input class="btn btn-default" type="button" value="Go to Permissions" onclick="location.href='@Url.Action("PermissionIndex", "Admin")'" />
</div>
