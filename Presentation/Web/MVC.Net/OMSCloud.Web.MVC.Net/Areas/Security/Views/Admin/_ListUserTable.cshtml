@model IEnumerable<OMSCloud.Web.MVC.Net.Areas.Security.Models.ApplicationUser>


@*<div class="panel panel-default" id="divUsers">*@

<div class="">
    <table class="table table-striped table-hover table-bordered table-responsive dataTable" id="UserTable" style="width:100%">
        <thead>
            <tr>
                <td style="font-weight:bold; font-size:large">
                    UserName
                </td>
                <td style="font-weight:bold; font-size:large">
                    Last Name
                </td>
                <td style="font-weight:bold; font-size:large">
                    First Name
                </td>
                <td>
                    Phone Number
                </td>
                <td style="font-weight:bold; font-size:large">
                    Inactive
                </td>
                <td style="font-weight:bold; font-size:large">
                    Email
                </td>
                <td style="font-weight:bold; font-size:large;width:80px">
                    Action
                </td>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.ActionLink(item.UserName, "UserDetails", new { id = item.Id })
                    </td>
                    <td>
                        @item.Lastname
                    </td>
                    <td>
                        @item.Firstname
                    </td>
                    <td>
                        @item.PhoneNumber
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Inactive)
                    </td>

                    <td>@item.Email</td>
                    <td>
                        @*<a href="@Url.Action("UserEdit", "Admin", new { id = item.Id })" id=@item.Id>
        <img src="@Url.Content("~/Areas/Security/Content/Images/pen.png")" />
        </a>*@
                        <a href="@Url.Action("UserEdit", "Admin", new { id = item.Id })" class="btn btn-xs btn-default" data-toggle="tooltip" data-placement="top" title="Edit"><i class="glyphicon glyphicon-pencil"></i></a>
                        @*<a href="@Url.Action("UserDetails", "Admin", new { id = item.Id })" class="btn btn-xs btn-default" data-toggle="tooltip" data-placement="top" title="Detail"><i class="glyphicon glyphicon-edit"></i></a>*@
                        @*<img class="deleteUser" id=@item.Id src="@Url.Content("~/Areas/Security/Content/Images/bin.png")" />*@
                        <a class="deleteUser btn btn-xs btn-danger" id=@item.Id data-toggle="tooltip" data-placement="top" title="Delete"><i class="glyphicon glyphicon-remove-sign"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@*</div>*@

<script type="text/javascript">
    $(document).ready(function () {
        //Unbind the original image 'href' set by the controller...
        $('.deleteUser').attr('href', 'javascript://');
        $('.deleteUser').click(function () {
            $dialog.data('id', $(this).attr('id')).data('Id', $(this).attr('Id')).dialog("open");
        });

        var $dialog = $('<div/>')
            .html("Warning: This will delete the selected User from the System and will prevent future access to the System.<br/><br/>Do you wish to continue?")
            .dialog({
                autoOpen: false,
                resizable: false,
                height: 250,
                modal: true,
                title: 'Delete User',
                buttons: [
                    {
                        text: "Continue",
                        id: "continuebtn",
                        click: function () {
                            var _id = $(this).data('Id');
                            var _parameters = { userId: _id };
                            $.ajax({
                                url: "/Security/Admin/DeleteUserReturnPartialView",
                                type: "GET",
                                data: _parameters,
                                success: function (data, textStatus, jqXHR) {
                                    $('#UserTable').html(data);
                                }
                            });
                            $(this).dialog('close');
                        }
                    },
                    {
                        text: "Cancel",
                        id: "cancelbtn",
                        click: function () {
                            $(this).dialog("close");
                        }
                    }]
            });
    });
</script>
