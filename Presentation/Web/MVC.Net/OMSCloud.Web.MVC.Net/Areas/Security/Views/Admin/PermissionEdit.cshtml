@model OMSCloud.Web.MVC.Net.Areas.Security.Models.PERMISSION
@{
    ViewBag.Title = "Modify Permission";
}

<div class="panel panel-default">
    <div class="panel-body">
        <fieldset>
            <legend>
                <h3 style="font-weight:bold; font-size:x-large">Permission Details</h3>
            </legend>
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true)

                @Html.HiddenFor(model => model.PermissionId)
                <div class="form-group">
                    @Html.LabelFor(model => model.PermissionDescription, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-6">
                        @Html.EditorFor(model => model.PermissionDescription, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.PermissionDescription, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-6">
                        <input type="submit" value="Update Permission" class="btn btn-success" />
                    </div>
                </div>
                @*<table style='width: 100%'>
                <tr>
                    <td style='width: 120px;font-weight: bold'>
                        @Html.LabelFor(model => model.PermissionDescription, "Description")
                    </td>
                    <td>
                        @Html.TextBoxFor(model => model.PermissionDescription, new { style = "width:450px" })
                        @Html.ValidationMessageFor(model => model.PermissionDescription)
                    </td>
                </tr>
            </table>
                <br />
                <input class="btn btn-default" type="submit" value="Update Permission" />
                <br />
                <br />*@ 
            }
        </fieldset>
    </div>
</div>
<div class="panel panel-default">
    <div class="panel-body">
        <fieldset>
            <legend>
                <h3>
                    Roles Associated with this Permission
                </h3>
            </legend>

            <div id="RolesTable">
                @Html.Partial("_ListRolesTable4Permission", Model)
            </div>
            <div>
                @Html.Partial("_AddRole4Permission", Model)
            </div>
        </fieldset>
    </div>
</div>

<div>
    <input class="btn btn-default" type="button" value="Go to Permissions" onclick="location.href='@Url.Action("PermissionIndex", "Admin")'" />
</div>
