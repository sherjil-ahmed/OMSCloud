@model IEnumerable<OMSCloud.Contracts.ViewModels.LocalizedPropertyModel>

@{
    ViewBag.Title = "Index";
}
<p>
    @*@Html.ActionLink("Create New", "Create")*@
    <a href="@Url.Action("Create")" class="btn btn-md btn-default"><i class="glyphicon glyphicon-plus"></i> Create New</a>
</p>
<table class="table table-striped table-bordered dataTable" style="width:100%">
   <thead>
       <tr>
           <th>
               @Html.DisplayNameFor(model => model.RequestedByProfileId)
           </th>
           <th>
               @Html.DisplayNameFor(model => model.EntityId)
           </th>
           <th>
               @Html.DisplayNameFor(model => model.LanguageId)
           </th>
           <th>
               @Html.DisplayNameFor(model => model.LocaleKeyGroup)
           </th>
           <th>
               @Html.DisplayNameFor(model => model.LocaleKey)
           </th>
           <th>
               @Html.DisplayNameFor(model => model.LocaleValue)
           </th>
           <th></th>
       </tr>
   </thead>
  <tbody>
      @foreach (var item in Model)
      {
          <tr>
              <td>
                  @Html.DisplayFor(modelItem => item.RequestedByProfileId)
              </td>
              <td>
                  @Html.DisplayFor(modelItem => item.EntityId)
              </td>
              <td>
                  @Html.DisplayFor(modelItem => item.LanguageId)
              </td>
              <td>
                  @Html.DisplayFor(modelItem => item.LocaleKeyGroup)
              </td>
              <td>
                  @Html.DisplayFor(modelItem => item.LocaleKey)
              </td>
              <td>
                  @Html.DisplayFor(modelItem => item.LocaleValue)
              </td>
              <td>
                  @*@Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
                  @Html.ActionLink("Details", "Details", new { id = item.Id }) |
                  @Html.ActionLink("Delete", "Delete", new { id = item.Id })*@
                  <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-xs btn-default" data-toggle="tooltip" data-placement="top" title="Edit"><i class="glyphicon glyphicon-pencil"></i></a>
                  <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-xs btn-info" data-toggle="tooltip" data-placement="top" title="Details"><i class="glyphicon glyphicon-eye-open"></i></a>
                  <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-xs btn-danger" data-toggle="tooltip" data-placement="top" title="Delete"><i class="glyphicon glyphicon-remove-sign"></i></a>
              </td>
          </tr>
      }
  </tbody>

</table>
