@model IEnumerable<OMSCloud.Contracts.ViewModels.CurrencyModel>

@{
    ViewBag.Title = "Currency List";
}
<div class="panel panel-default">
    <div class="panel-heading">
        @*@Html.ActionLink("Create New", "Create")*@
        <a href="@Url.Action("Create")" class="btn btn-md btn-default"><i class="glyphicon glyphicon-plus"></i> Create New</a>
    </div>

    <div class="panel-body">
        <table class="table table-striped  table-hover table-responsive  table-bordered dataTable" style="width:100%">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Name)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CurrencyCode)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Rate)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DisplayLocale)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CustomFormatting)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.LimitedToStores)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Published)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DisplayOrder)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.RoundingTypeId)
                    </th>
                    <th></th>
                </tr>

            </thead>
            <tbody>
                @if (Model != null)
                {
                    foreach (var item in Model)
                    {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Name)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.CurrencyCode)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Rate)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.DisplayLocale)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.CustomFormatting)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.LimitedToStores)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Published)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.DisplayOrder)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.RoundingTypeId)
                        </td>
                        <td>
                            @*@Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
                                @Html.ActionLink("Details", "Details", new { id = item.Id }) |
                                @Html.ActionLink("Delete", "Delete", new { id = item.Id })*@
                            <a href="@Url.Action("Edit", new { id = item.CurrencyId })" class="btn btn-xs btn-default" data-toggle="tooltip" data-placement="top" title="Edit"><i class="glyphicon glyphicon-pencil"></i></a>
                            <a href="@Url.Action("Details", new { id = item.CurrencyId })" class="btn btn-xs btn-info" data-toggle="tooltip" data-placement="top" title="Details"><i class="glyphicon glyphicon-eye-open"></i></a>
                            <a href="@Url.Action("Delete", new { id = item.CurrencyId })" class="btn btn-xs btn-danger" data-toggle="tooltip" data-placement="top" title="Delete"><i class="glyphicon glyphicon-remove-sign"></i></a>
                        </td>
                    </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>