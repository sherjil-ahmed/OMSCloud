@model IEnumerable<OMSCloud.Contracts.ViewModels.ProductAttributePairModel>
@{
    ViewBag.Title = "Product-Attribute List";
}
<div class="panel panel-default">
    <div class="panel-heading">
        <p>
            @*@Html.ActionLink("Create New", "Create")*@
            <a href="@Url.Action("Create")" class="btn btn-md btn-default"><i class="glyphicon glyphicon-plus"></i> Create New</a>
        </p>
    </div>
    <div class="panel-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover table-responsive table-bordered dataTable" style="width:100%">
                <thead>
                    <tr>
                        <th class="hidden">
                            @Html.DisplayNameFor(model => model.ProductAttributePairID)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.ProductName)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.AttributeName)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.AttributeValue)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.DisplayOrder)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.IsAssigned)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.IsSelectedForVariation)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.VariationInPrice)
                        </th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                        <tr>
                            <td class="hidden">
                                @Html.DisplayFor(modelItem => item.ProductAttributePairID)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ProductName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.AttributeName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.AttributeValue)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.DisplayOrder)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.IsAssigned)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.IsSelectedForVariation)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.VariationInPrice)
                            </td>
                            <td>
                                @*@Html.ActionLink("Edit", "Edit", new { id = item.ProductAttributePairID }) |
                                    @Html.ActionLink("Details", "Details", new { id = item.ProductAttributePairID }) |
                                    @Html.ActionLink("Delete", "Delete", new { id = item.ProductAttributePairID })*@
                                <a href="@Url.Action("Edit", new { id = item.ProductAttributePairID })" class="btn btn-xs btn-default" data-toggle="tooltip" data-placement="top" title="Edit"><i class="glyphicon glyphicon-pencil"></i></a>
                                <a href="@Url.Action("Details", new { id = item.ProductAttributePairID })" class="btn btn-xs btn-info" data-toggle="tooltip" data-placement="top" title="Details"><i class="glyphicon glyphicon-eye-open"></i></a>
                                <a href="@Url.Action("Delete", new { id = item.ProductAttributePairID })" class="btn btn-xs btn-danger" data-toggle="tooltip" data-placement="top" title="Delete"><i class="glyphicon glyphicon-remove-sign"></i></a>
                            </td>
                        </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>