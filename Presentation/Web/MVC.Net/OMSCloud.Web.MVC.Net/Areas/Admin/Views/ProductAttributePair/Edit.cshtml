@model OMSCloud.Contracts.ViewModels.ProductAttributePairModel
@{
    ViewBag.Title = "Product-Attribute Edit";
}
<div class="panel panel-default">
    <div class="panel-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
        <div class="form-horizontal">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="form-group hidden">
                @Html.LabelFor(model => model.ProductAttributePairID, htmlAttributes: new { @class = "control-label col-md-2" })
