@model OMSCloud.Contracts.ViewModels.TaxViewModel
@using OMSCloud.Contracts.Common.DBEnums

@{
    ViewBag.Title = "Tax Create";
}

<script>
    function provinceTaxRadioButtonChanged() {

        if ($("#provinceTaxRadioButton").is(":checked")) {
            $("#provinceDropDownTax").prop("disabled", false);
        } else {
            $("#provinceDropDownTax").prop("disabled", true);
        }
        $("#provinceDropDownTax").val(-1);
    }

</script>
<div class="panel panel-default">
    <div class="panel-body">

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="form-group hidden">
                    @Html.LabelFor(model => model.TaxID, htmlAttributes: new { @class = "control-label col-md-1" })
                    <div class="col-md-6">
                        @Html.EditorFor(model => model.TaxID, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.TaxID, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.IsPercentage, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-2">
                        @Html.EditorFor(model => model.TaxValue, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                    <div class="col-md-1">
                        @Html.CheckBoxFor(model => model.IsPercentage, new { @class = "" })
                    </div>

                    @Html.LabelFor(model => model.TaxTypeTitle, htmlAttributes: new { @class = "control-label col-md-1" })
                    <div class="col-md-2">
                        @Html.DropDownListFor(model => model.TaxTypeID, ViewBag.taxType as SelectList, "--Select DataType--", new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.TaxTypeID, "", new { @class = "text-danger" })
                    </div>


                </div>
                <div class="form-group">
                    @Html.Label("Tax by Federal/Country Govt", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-2">
                        @Html.EditorFor(model => model.LocationName, new { htmlAttributes = new { @class = "form-control", @readonly = "true" } })
                    </div>
                    <div class="col-md-1">
                        @Html.RadioButtonFor(model => model.LocationLevelId, (int)DBLocationLevelEnum.Country, new { @class = "", onchange = "provinceTaxRadioButtonChanged()" })
                    </div>
                    @Html.LabelFor(model => model.EffectiveDate, htmlAttributes: new { @class = "control-label col-md-1" })
                    <div class="col-md-2">
                        @Html.EditorFor(model => model.EffectiveDate, new { @class = "form-control datepicker", @type = "date", @Value = Model.EffectiveDate.ToString("yyyy-MM-dd") })
                        @Html.ValidationMessageFor(model => model.EffectiveDate, "", new { @class = "text-danger" })
                    </div>

                </div>
                <div class="form-group">
                    @Html.Label("Tax by Provincial/State Govt", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-2">
                        @Html.DropDownListFor(model => model.LocationID, ViewBag.ProvinceList as SelectList, "--Select Province--", new { id = "provinceDropDownTax", @class = "form-control", @disabled = "true" })
                    </div>
                    <div class="col-md-1">
                        @Html.RadioButtonFor(model => model.LocationLevelId, (int)DBLocationLevelEnum.Province, new { id = "provinceTaxRadioButton", @class = "", onchange = "provinceTaxRadioButtonChanged()" })
                    </div>
                    @Html.LabelFor(model => model.StatusTitle, htmlAttributes: new { @class = "control-label col-md-1" })
                    <div class="col-md-2">
                        @Html.DropDownListFor(model => model.StatusID, ViewBag.status as SelectList, "--Select status--", new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.StatusID, "", new { @class = "text-danger" })
                    </div>

                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-6">
                        @Html.EditorFor(model => model.Description, new { htmlAttributes = new { @class = "form-control", rows = "8" } })
                        @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                    </div>
                </div>


                <div class="form-group">
                    <div class="col-md-offset-2 col-md-6">
                        <input type="submit" value="Create" class="btn btn-success" />
                    </div>
                </div>
            </div>
        }

    </div>
</div>
<div class="form-actions no-color">
    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-success" })
</div>
