@model IEnumerable<OMSCloud.Contracts.ViewModels.TaxViewModel>
@{
    ViewBag.Title = "Tax List";
}
<div class="panel panel-default">
    <div class="panel-heading">
        <p>
            <a href="@Url.Action("Create")" class="btn btn-md btn-default"><i class="glyphicon glyphicon-plus"></i> Create New</a>
        </p>
    </div>
    <div class="panel-body">
        <table class="table table-striped table-hover table-responsive table-bordered dataTable" style="width:100%">
        <thead>
            <tr>
                <th class="hidden">
                    @Html.DisplayNameFor(model => model.TaxID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.TaxValue)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.TaxTypeTitle)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Description)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.StatusTitle)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.EffectiveDate)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.IsPercentage)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.TaxTerritoryLevel)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.LocationName)
                </th>
                @*<th></th>*@
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="hidden">
                            @Html.DisplayFor(modelItem => item.TaxID)
                        </td>
                        <td>
                            <a href="@Url.Action("Edit", new { id = item.TaxID })" class="btn btn-xs btn-default" data-toggle="tooltip" data-placement="top" title="Edit"><i class="glyphicon glyphicon-pencil"></i>@Html.DisplayFor(modelItem => item.TaxValue)</a>
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.TaxTypeTitle)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Description)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.StatusTitle)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.EffectiveDate)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.IsPercentage)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.TaxTerritoryLevel)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.LocationName)
                        </td>
                        @*<td>
                            <a href="@Url.Action("Details", new { id = item.TaxID })" class="btn btn-xs btn-info" data-toggle="tooltip" data-placement="top" title="Details"><i class="glyphicon glyphicon-eye-open"></i></a>
                            <a href="@Url.Action("Delete", new { id = item.TaxID })" class="btn btn-xs btn-danger" data-toggle="tooltip" data-placement="top" title="Delete"><i class="glyphicon glyphicon-remove-sign"></i></a>
                        </td>*@
                    </tr>
                }
            }
        </tbody>
        </table>
    </div>
</div>