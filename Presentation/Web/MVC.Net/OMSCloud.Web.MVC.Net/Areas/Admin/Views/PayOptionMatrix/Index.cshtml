@model IEnumerable<OMSCloud.Contracts.ViewModels.PayOptionMatrixModel>

@{
    ViewBag.Title = "Index";
}

<div class="panel panel-default">
    <div class="panel-heading">
        <a href="@Url.Action("Create")" class="btn btn-md btn-default"><i class="glyphicon glyphicon-plus"></i> Create New</a>
    </div>
    <div class="panel-body">
        <table class="table table-striped table-hover table-responsive table-bordered dataTable" style="width:100%">
            <thead>
                <tr>
                    <th class="hidden">
                        @Html.DisplayNameFor(model => model.RequestedByProfileId)
                    </th>
                    <th class="hidden">
                        @Html.DisplayNameFor(model => model.PayOptionMatrixID)
                    </th>
                    <th class="hidden">
                        @Html.DisplayNameFor(model => model.PayModeID)
                    </th>
                    <th class="hidden">
                        @Html.DisplayNameFor(model => model.PayTypeID)
                    </th>
                    <th class="">
                        @Html.DisplayNameFor(model => model.PayModeTitle)
                    </th>
                    <th class="">
                        @Html.DisplayNameFor(model => model.PayTypeTitle)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.IsSystem)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="hidden">
                            @Html.DisplayFor(modelItem => item.RequestedByProfileId)
                        </td>
                        <td class="hidden">
                            @Html.DisplayFor(modelItem => item.PayOptionMatrixID)
                        </td>
                        <td class="hidden">
                            @Html.DisplayFor(modelItem => item.PayModeID)
                        </td>
                        <td class="hidden">
                            @Html.DisplayFor(modelItem => item.PayTypeID)
                        </td>
                        <td class="">
                            @Html.DisplayFor(modelItem => item.PayModeTitle)
                        </td>
                        <td class="">
                            @Html.DisplayFor(modelItem => item.PayTypeTitle)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.IsSystem)
                        </td>
                        <td>
                            @*@Html.ActionLink("Edit", "Edit", new { id = item.PayOptionMatrixID }) |
                                @Html.ActionLink("Details", "Details", new { id = item.PayOptionMatrixID }) |
                                @Html.ActionLink("Delete", "Delete", new { id = item.PayOptionMatrixID })*@
                            <a href="@Url.Action("Edit", new { id = item.PayOptionMatrixID })" class="btn btn-xs btn-default" data-toggle="tooltip" data-placement="top" title="Edit"><i class="glyphicon glyphicon-pencil"></i></a>
                            <a href="@Url.Action("Details", new { id = item.PayOptionMatrixID })" class="btn btn-xs btn-info" data-toggle="tooltip" data-placement="top" title="Details"><i class="glyphicon glyphicon-eye-open"></i></a>
                            <a href="@Url.Action("Delete", new { id = item.PayOptionMatrixID })" class="btn btn-xs btn-danger" data-toggle="tooltip" data-placement="top" title="Delete"><i class="glyphicon glyphicon-remove-sign"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>