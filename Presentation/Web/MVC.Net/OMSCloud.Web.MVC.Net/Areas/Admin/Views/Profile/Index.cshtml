@model IEnumerable<OMSCloud.Contracts.ViewModels.ProfileModel>
@using OMSCloud.Contracts.Common.DBEnums
@{
    ViewBag.Title = "Profile List";
}
<div class="panel panel-default">
    <div class="panel-heading">
        <p>
            <a href="@Url.Action("Create")" class="btn btn-md btn-default"><i class="glyphicon glyphicon-plus"></i> Create New</a>
        </p>
    </div>
    <div class="panel-body">
        <table class="table table-striped table-hover table-responsive table-bordered dataTable" style="width:100%">
            <thead>
                <tr>
                    <th class="hidden">
                        @Html.DisplayNameFor(model => model.ProfileID)
                    </th>
                    <th class="hidden">
                        @Html.DisplayNameFor(model => model.UserID)
                    </th>
                    <th>
                        Full Name
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.UserName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.FatherName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.AdminUserTypeID)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CreatedOn)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.LastLogin)
                    </th>
                    <th>

                    </th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    foreach (var item in Model)
                    {
                        var FullName = item.FirstName + " " + item.MiddleName + " " + item.LastName;

                <tr>
                    <td class="hidden">
                        @Html.DisplayFor(modelItem => item.ProfileID)
                    </td>
                    <td class="hidden">
                        @Html.DisplayFor(modelItem => item.UserID)
                    </td>
                    <td>
                        <a href="@Url.Action("Edit", new { id = item.ProfileID })" class="btn btn-md btn-default " style="color:#000" data-toggle="tooltip" data-placement="top"><i class="glyphicon glyphicon-pencil"></i>@FullName</a>
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.UserName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.FatherName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.AdminUserTypeID)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CreatedOn)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.LastLogin)
                        @*@Html.DisplayFor(modelItem => item.EMail_2FA)
                        @Html.DisplayFor(modelItem => item.SMS_2FA)*@
                    </td>
                    <td class="menu_td">
                        @*<i class="fa fa-arrows"></i>*@
                        <div class="menu-opener"><i class="fa fa-bars" aria-label="Toggle sidebar"></i></div>
                        <div class="menu-closer" style="display: none;"><i class="fa fa-close" aria-label="Toggle sidebar"></i></div>
                        <div class="menu_div">
                            <div>
                                <a href="@Url.Action("IndexPublic", "ProfileVerification", new { id = item.ProfileID })" class="" data-toggle="tooltip" data-placement="top"><i class="btn btn-xs btn-success glyphicon glyphicon-check"></i> Verification</a>

                            </div>
                            @*<div>
                 <a href="@Url.Action("Edit", new { id = item.ProfileID })" class="" data-toggle="tooltip" data-placement="top" ><i class="btn btn-xs btn-default glyphicon glyphicon-pencil"></i>Edit</a>

             </div>
            <div>
                 <a href="@Url.Action("Details", new { id = item.ProfileID })"  data-toggle="tooltip" data-placement="top" ><i class="btn btn-xs  btn-info  glyphicon glyphicon-eye-open"></i>Details</a>

             </div>
                            <div>
                                <a href="@Url.Action("Delete", new { id = item.ProfileID })" data-toggle="tooltip" data-placement="top"><i class="btn btn-xs btn-danger glyphicon glyphicon-remove-sign"></i> Delete</a>
                            </div>*@
                            @*, shopId = null orderStatusId = 3, parentCartId = 4,*@
                            @if (item.UserTypeID == (long)DBUserTypeEnum.Seller)
                            {
                            }
                            else
                            {
                                <div>
                                    <a href="@Url.Action("Index", "Order", new { buyerProfileId = item.ProfileID})" data-toggle="tooltip" data-placement="top"> <i class="btn btn-xs btn-success glyphicon glyphicon-check"></i> All Orders</a>
                                </div>
                                <div>
                                    <a href="@Url.Action("Index", "Order", new { buyerProfileId = item.ProfileID, orderStatusId = (int)DBOrderStatusEnum.NewOrder })" data-toggle="tooltip" data-placement="top"><i class="btn btn-xs btn-success glyphicon glyphicon-check"></i> New Orders</a>
                                </div>
                                <div>
                                    <a href="@Url.Action("Index", "Order", new { buyerProfileId = item.ProfileID, orderStatusId = (int)DBOrderStatusEnum.OrderPlaced })" data-toggle="tooltip" data-placement="top"><i class="btn btn-xs btn-success glyphicon glyphicon-check"></i> Just Paid</a>
                                </div>
                                <div>
                                    <a href="@Url.Action("Index", "Order", new { buyerProfileId = item.ProfileID, orderStatusId = (int)DBOrderStatusEnum.OrderInProcess })" data-toggle="tooltip" data-placement="top"><i class="btn btn-xs btn-success glyphicon glyphicon-check"></i> In Process</a>
                                </div>
                                <div>
                                    <a href="@Url.Action("Index", "Order", new { buyerProfileId = item.ProfileID, orderStatusId = (int)DBOrderStatusEnum.OrderDispatched_ReadyforPickup })" data-toggle="tooltip" data-placement="top"><i class="btn btn-xs btn-success glyphicon glyphicon-check"></i> Order dispatched</a>
                                </div>
                                <div>
                                    <a href="@Url.Action("Index", "Order", new { buyerProfileId = item.ProfileID, orderStatusId = (int)DBOrderStatusEnum.Order_Delivered_Pickedup })" data-toggle="tooltip" data-placement="top"><i class="btn btn-xs btn-success glyphicon glyphicon-check"></i> Order Delivered</a>
                                </div>
                                <div>
                                    <a href="@Url.Action("Index", "Order", new { buyerProfileId = item.ProfileID, orderStatusId = (int)DBOrderStatusEnum.OrderCompleted })" data-toggle="tooltip" data-placement="top"><i class="btn btn-xs btn-success glyphicon glyphicon-check"></i> Successfull Orders</a>
                                </div>
                            }
                        </div>
                    </td>
                </tr>
                    }
                }

            </tbody>
        </table>
    </div>
</div>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
<script>
    $(document).ready(function () {
        //alert('hello');
        $(".menu-opener").click(function () {
            //  alert('hello');
            $(".menu_div").css("display", "none");
            $(".menu-opener").css("display", "none");
            $(".menu-closer").css("display", "");
            $(this).parents(".menu_td").find(".menu_div").toggle();

        });
        $(".menu-closer").click(function () {
            //  alert('hello');
            $(".menu_div").css("display", "none");
            $(".menu-opener").css("display", "");
            $(".menu-closer").css("display", "none");
        });
    });
</script>