@model IEnumerable<OMSCloud.Contracts.ViewModels.AppConfigModel>

@{
    ViewBag.Title = "Application Configuration List";
}
<div class="panel panel-default">
    <div class="panel-heading">
        <p>
            <a href="@Url.Action("Create")" class="btn btn-md btn-default"><i class="glyphicon glyphicon-plus"></i> Create New</a>
        </p>
    </div>

    <div class="panel-body">
        <table class="table table-striped table-responsive table-hover table-bordered dataTable" style="width:100%">
            <thead>
                <tr>
                    <th class="hidden">
                        @Html.DisplayNameFor(model => model.ConfigID)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ConfigTitle)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ConfigValue)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DisplayText)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ParentConfigTitle)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Description)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.IsSystem)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    foreach (var item in Model)
                    {
                    <tr>
                        <td class="hidden">
                            @Html.DisplayFor(modelItem => item.ConfigID)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.ConfigTitle)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.ConfigValue)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.DisplayText)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.ParentConfigTitle)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Description)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.IsSystem)
                        </td>
                        <td>
                            <a href="@Url.Action("Edit", new { id = item.ConfigID })" class="btn btn-xs btn-default" data-toggle="tooltip" data-placement="top" title="Edit"><i class="glyphicon glyphicon-pencil"></i></a>
                            @*<a href="@Url.Action("Details", new { id = item.ConfigID })" class="btn btn-xs btn-info" data-toggle="tooltip" data-placement="top" title="Details"><i class="glyphicon glyphicon-eye-open"></i></a>
                            <a href="@Url.Action("Delete", new { id = item.ConfigID })" class="btn btn-xs btn-danger" data-toggle="tooltip" data-placement="top" title="Delete"><i class="glyphicon glyphicon-remove-sign"></i></a>*@
                        </td>
                    </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>