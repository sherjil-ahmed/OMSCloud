@model OMSCloud.Contracts.ViewModels.OrderStatusModel
@{
    ViewBag.Title = "Delete Order Status";
}
<script>
    function onDelete(Id, IsSystem) {
        event.preventDefault();
        ShowModal();
    }
</script>
<div class="panel panel-default">
    <div class="panel-body">
        <dl class="dl-horizontal">
            <dt class="hidden">
                @Html.DisplayNameFor(model => model.OrderStatusID)
            </dt>

            <dd class="hidden">
                @Html.DisplayFor(model => model.OrderStatusID)
            </dd>

            <dt>
                @Html.DisplayNameFor(model => model.OrderStatusTitle)
            </dt>

            <dd>
                @Html.DisplayFor(model => model.OrderStatusTitle)
            </dd>

            <dt>
                @Html.DisplayNameFor(model => model.Description)
            </dt>

            <dd>
                @Html.DisplayFor(model => model.Description)
            </dd>
            <dt>
                @Html.DisplayNameFor(model => model.IsSystem)
            </dt>

            <dd>
                @Html.DisplayFor(model => model.IsSystem)
            </dd>
            <dt>
                @Html.DisplayNameFor(model => model.IsOrder)
            </dt>

            <dd>
                @Html.DisplayFor(model => model.IsOrder)
            </dd>
        </dl>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-actions no-color">
                <input type="submit" value="Delete" class="btn btn-danger" onclick="onDelete(@Model.OrderStatusID, @Model.IsSystem)" />
            </div>
        }
    </div>
</div>
<div>
    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-success" })

    @Html.Partial("../partial/_IsSystemAlertModal", new ViewDataDictionary() {
        {"Title", "Alert" },
        {"modalDivId", "AlertModal" },
        {"modalBodyId", "AlertModalBody" },

    })
</div>
