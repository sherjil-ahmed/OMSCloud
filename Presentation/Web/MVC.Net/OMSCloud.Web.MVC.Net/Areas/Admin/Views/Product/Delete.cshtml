@model OMSCloud.Contracts.ViewModels.ProductModel
@{
    ViewBag.Title = "Delete Product";
}
<script>
    function onDelete(Id, IsSystem) {
        event.preventDefault();
        ShowModal();
    }
</script>
<div class="panel panel-default">
    <div class="panel-body">
        <h3>Are you sure you want to delete this?</h3>
        <div>
            <dl class="dl-horizontal">
                <dt class="hidden">
                    @Html.DisplayNameFor(model => model.ProductID)
                </dt>

                <dd class="hidden">
                    @Html.DisplayFor(model => model.ProductID)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.ProductTitle)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.ProductTitle)
                </dd>

                <dt  class="hidden">
                    @Html.DisplayNameFor(model => model.BrifeDescription)
                </dt>

                <dd  class="hidden">
                    @Html.DisplayFor(model => model.BrifeDescription)
                </dd>

                <dt class="hidden">
                    @Html.DisplayNameFor(model => model.ProductActualImagePath)
                </dt>

                <dd class="hidden">
                    <img src="@ViewBag.ProductActualImagePath" alt="IMAGES" style="height:100px; width:100px" />
                </dd>

                <dt class="hidden">
                    @Html.DisplayNameFor(model => model.ProductImagePath)
                </dt>

                <dd class="hidden">
                    <img src="@ViewBag.ProductImagePath" alt="IMAGES" style="height:100px; width:100px" />
                </dd>

                <dt class="hidden">
                    @Html.DisplayNameFor(model => model.StockCount)
                </dt>

                <dd class="hidden">
                    @Html.DisplayFor(model => model.StockCount)
                </dd>

                <dt class="hidden">
                    @Html.DisplayNameFor(model => model.WebLink)
                </dt>

                <dd class="hidden">
                    @Html.DisplayFor(model => model.WebLink)
                </dd>

                <dt class="hidden">
                    @Html.DisplayNameFor(model => model.BasePrice)
                </dt>

                <dd class="hidden">
                    @Html.DisplayFor(model => model.BasePrice)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.SellingPrice)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.SellingPrice)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.UserRating)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.UserRating)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.AnalysisRank)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.AnalysisRank)
                </dd>

                <dt class="hidden">
                    @Html.DisplayNameFor(model => model.Description)
                </dt>

                <dd class="hidden">
                    @Html.DisplayFor(model => model.Description)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.ProductTypeName)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.ProductTypeName)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.BrandName)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.BrandName)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.SupplierName)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.SupplierName)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.StatusName)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.StatusName)
                </dd>

            </dl>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-actions no-color">
                    <input type="submit" value="Delete" class="btn btn-danger" @*onclick="onDelete(@Model.ProductID)"*@/>
                </div>
            }
        </div>
    </div>
</div>
<div>
    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-success" })

    @Html.Partial("../partial/DeleteModal", new ViewDataDictionary() {
                { "Title", "Delete"},
                { "modalDivId", "DeleteModal"},
                { "modalBodyId", "DeleteModalBody"},
                { "URL", "/Admin/Product/Delete/" + Model.ProductID.ToString()}
            })
</div>

