@model IEnumerable<OMSCloud.Contracts.ViewModels.CategoryAttributePairModel>
@{
    ViewBag.Title = "List of Category-Attribute ";
}
<div class="panel panel-default">
    <div class="panel-heading">
        <a href="@Url.Action("Create")" class="btn btn-md btn-default"><i class="glyphicon glyphicon-plus"></i> Create New</a>
    </div>
    <div class="panel-body">

            <table class="table table-striped table-hover table-responsive table-bordered dataTable" style="width:100%">
                <thead>
                    <tr>
                        <th class="hidden">
                            @Html.DisplayNameFor(model => model.CategoryAttributePairID)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.CategoryTitle)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.AttributeTitle)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.AttributeValue)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.IsAssigned)
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                    <tr>
                        <td class="hidden">
                            @Html.DisplayFor(modelItem => item.CategoryAttributePairID)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.CategoryTitle)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.AttributeTitle)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.AttributeValue)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.IsAssigned)
                        </td>
                        <td>
                            <a href="@Url.Action("Edit", new { id = item.CategoryAttributePairID })" class="btn btn-xs btn-default" data-toggle="tooltip" data-placement="top" title="Edit"><i class="glyphicon glyphicon-pencil"></i></a>
                            @*<a href="@Url.Action("Details", new { id = item.CategoryAttributePairID })" class="btn btn-xs btn-info" data-toggle="tooltip" data-placement="top" title="Details"><i class="glyphicon glyphicon-eye-open"></i></a>
                        <a href="@Url.Action("Delete", new { id = item.CategoryAttributePairID })" class="btn btn-xs btn-danger" data-toggle="tooltip" data-placement="top" title="Delete"><i class="glyphicon glyphicon-remove-sign"></i></a>
                        @Html.ActionLink("Edit", "Edit", new { id = item.CategoryAttributePairID }) |
        @Html.ActionLink("Details", "Details", new { id = item.CategoryAttributePairID }) |
        @Html.ActionLink("Delete", "Delete", new { id = item.CategoryAttributePairID })*@
                        </td>
                    </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
