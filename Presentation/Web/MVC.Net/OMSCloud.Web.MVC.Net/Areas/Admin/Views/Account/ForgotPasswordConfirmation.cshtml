@{
    ViewBag.Title = "Password Reset";
    Layout = "~/Areas/Admin/Views/Shared/_AuthLayout.cshtml";
    ViewBag.AuthTitle = "Confirm Forget Password";
}
<div>
    <table>
        <td><img src="~/Areas/Security/Content/Images/reset.png" /></td>
        <td class="security-formtitle">@ViewBag.Title<p class="security-formtitlesub">Reset Your Account Password</p></td>
    </table>
</div>
<hr />
<div class="form-group">
    <p style="font-size:20px;vertical-align:middle;text-indent:10px">Please check your email to reset your password.</p>
</div>
<div class="form-group">
    <div class="col-md-offset-2 col-md-10">
        
        @Html.ActionLink("Sing In", "Login", new { }, new { @class = "pull-right" })
    </div>
</div>
