@model IEnumerable<OMSCloud.Contracts.ViewModels.CategoryModel>
@{
    ViewBag.Title = "Category List";
}

<div class="panel panel-default">
    <div class="panel-heading">
        <a href="@Url.Action("Create")" class="btn btn-md btn-default"><i class="glyphicon glyphicon-plus"></i> Create New</a>
    </div>
    <div class="panel-body">
        <div class="row">
            <div class="col-md-12">
                <form class="pull-right form-inline" method="get" action="/Admin/Category/Index">
                    <div class="form-group">
                        <input type="text" class="form-control input-sm" placeholder="Search Category"  value="@ViewBag.SearchString" name="searchString">
                    </div>
                    <button type="submit" class="btn btn-default btn-sm">Submit</button>
                </form>
            </div>   <br /><br />
            <div class="col-md-12">
                <table id="dtbl" class="table table-striped table-hover table-responsive table-bordered " style="width:100%">
                    <thead>
                        <tr>
                            <th class="hidden">
                                @Html.DisplayNameFor(model => model.CategoryID)
                            </th>
                            <th>
                                @Html.ActionLink("Category", "Index", new { sortOrder = ViewBag.CategorySortParm, searchString = ViewBag.SearchString }, new { @style = " color: #000;" })
                            </th>
                            <th>
                                @Html.ActionLink("Category Type", "Index", new { sortOrder = ViewBag.CategoryTypeSortParm, searchString = ViewBag.SearchString }, new { @style = " color: #000;" })
                            </th>
                            <th>
                                @Html.ActionLink("Parent Category", "Index", new { sortOrder = ViewBag.ParentCategorySortParm, searchString = ViewBag.SearchString }, new { @style = " color: #000;" })
                            </th>
                            <th>
                                @Html.ActionLink("Status", "Index", new { sortOrder = ViewBag.StatusSortParm, searchString = ViewBag.SearchString }, new { @style = " color: #000;" })
                            </th>
                            <th>
                                @Html.ActionLink("IsSystem", "Index", new { sortOrder = ViewBag.IsSystemSortParm, searchString = ViewBag.SearchString }, new { @style = " color: #000;" })
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="hidden">
                                        @Html.DisplayFor(modelItem => item.CategoryID)
                                    </td>
                                    <td>
                                        <a href="@Url.Action("Edit", new { id = item.CategoryID })" style="color:#000" class="btn btn-md btn-default" data-toggle="tooltip" data-placement="top"><i class="glyphicon glyphicon-pencil"></i> - @Html.DisplayFor(modelItem => item.CategoryTitle)</a>
                                    </td>
                                    <td>
                                        @Html.DisplayFor(model => item.CategoryTypeTitle)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(model => item.CategoryParentTitle)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(model => item.StatusName)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.IsSystem)
                                    </td>
                                    @*<td>
                        <a href="@Url.Action("Edit", new { id = item.CategoryID })" class="btn btn-xs btn-default" data-toggle="tooltip" data-placement="top" title="Edit"><i class="glyphicon glyphicon-pencil"></i></a>
                        <a href="@Url.Action("Details", new { id = item.CategoryID })" class="btn btn-xs btn-info" data-toggle="tooltip" data-placement="top" title="Details"><i class="glyphicon glyphicon-eye-open"></i></a>
                        <a href="@Url.Action("Delete", new { id = item.CategoryID })" class="btn btn-xs btn-danger" data-toggle="tooltip" data-placement="top" title="Delete"><i class="glyphicon glyphicon-remove-sign"></i></a>
                    </td>*@
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="55">There is no record to show</td></tr>
                        }
                    </tbody>
                </table>
                <ul class="pagination pull-right">
                    @if (ViewBag.CurrentPageIndex > 1)
                    {
                    <li>
                        <a href="/Admin/Category/Index?PageNum=1&searchString=@ViewBag.SearchString&sortOrder=@ViewBag.SortOrder" class="edge">|&lt;</a>
                    </li>
                    <li>
                        <a href="/Admin/Category/Index?PageNum=@(ViewBag.CurrentPageIndex - 1)&searchString=@ViewBag.SearchString&sortOrder=@ViewBag.SortOrder" class="edge">&lt;</a>
                    </li>
                    }
                    @{
                        var DISPLAY_PAGES = 6;
                        var startIdx = (ViewBag.CurrentPageIndex - DISPLAY_PAGES) < 0 ? 1 : (ViewBag.CurrentPageIndex < ViewBag.PageCount) ? ViewBag.CurrentPageIndex - (DISPLAY_PAGES - 2) : ViewBag.CurrentPageIndex - (DISPLAY_PAGES - 1);
                        var endIdx = (startIdx + DISPLAY_PAGES) - 1 > ViewBag.PageCount ? ViewBag.PageCount : (startIdx + DISPLAY_PAGES) - 1;

                        for (var i = startIdx; i <= endIdx; i++)
                        {
                            if (i != ViewBag.CurrentPageIndex)
                            {
                                <li><a href="/Admin/Category/Index?PageNum=@i&searchString=@ViewBag.SearchString&sortOrder=@ViewBag.SortOrder">@i</a></li>
                            }
                            else
                            {
                                <li><span class="active">@i</span></li>
                            }
                        }
                    }
                    @if (ViewBag.CurrentPageIndex < ViewBag.PageCount)
                    {
                        <li>
                            <a href="/Admin/Category/Index?PageNum=@(ViewBag.CurrentPageIndex + 1)&searchString=@ViewBag.SearchString&sortOrder=@ViewBag.SortOrder" class="edge">&gt;</a>
                        </li>
                        <li>
                            <a href="/Admin/Category/Index?PageNum=@(ViewBag.PageCount)&searchString=@ViewBag.SearchString&sortOrder=@ViewBag.SortOrder" class="edge">&gt;|</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
