@model OMSCloud.Contracts.ViewModels.CategoryModel
@{
    ViewBag.Title = "Modify Category";
}
<div class="panel panel-default">
    <div class="panel-body">
            @using (Html.BeginForm("Edit", "Category", FormMethod.Post, new { enctype = "multipart/form-data", id = "CategoryEditForm" }))
            {
                @Html.AntiForgeryToken()
                <div class="form-horizontal">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="col-md-12">
                        <div class="tabs">
                            <ul class="nav nav-tabs">
                                <li class="active">
                                    <a href="#basic" data-toggle="tab">Basic</a>
                                </li>
                                <li>
                                    <a href="#attribute" data-toggle="tab">Attribute</a>
                                </li>
                            </ul>
                            <div class="tab-content">
                                <div id="basic" class="tab-pane active">
                                    @Html.Partial("partial/CategoryBasicInfo")
                                </div>
                                <div id="attribute" class="tab-pane">
                                    @{
                                        Html.RenderAction("AssociateCategoryWithAttribute", "Category", new { id = Model.CategoryID });
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-group hidden">
                        <div class="col-md-6">
                            @Html.EditorFor(model => model.ModifiedOn.Ticks, new { htmlAttributes = new { @class = "form-control" } })
                        </div>
                    </div>

                </div>
            }
    </div>
</div>
<div>
    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-success" })
</div>

