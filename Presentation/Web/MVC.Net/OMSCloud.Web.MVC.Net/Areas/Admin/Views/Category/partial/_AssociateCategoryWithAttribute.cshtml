

@model OMSCloud.Contracts.ViewModels.CategoryAttributePairLookupModel 


<div class="container">
    <div class="form-group">
        @Html.LabelFor(model => model.AttributeTitle, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-3">
            @Html.DropDownListFor(model => model.AttributeID, ViewBag.attributeList as SelectList, "--Please Select--", new { @class = "form-control", id = "cmbAttribute" })
            @Html.ValidationMessageFor(model => model.AttributeID, "", new { @class = "text-danger" })
        </div>
    @*</div>
    <div class="col-md-3">*@
        <a href="#" class="btn btn-success" onclick="ShowModal()">Create New Attribute</a>
        @Html.Partial("../partial/Catalogue/Modal", new ViewDataDictionary() {
                    { "Title", "Create New Attribute"},
                    { "modalDivId", "attributeCreateModal"},
                    { "modalBodyId", "attributeCreateModalBody"},
                    { "URL", "/Admin/Attribute/CreateAttribute/" + ViewContext.RouteData.Values["id"].ToString()}
                })
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.AttributeValue, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-6">
            @Html.EditorFor(model => model.AttributeValue, new { htmlAttributes = new { @class = "form-control", id = "attributeValue" } })
            @Html.ValidationMessageFor(model => model.AttributeValue, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.DisplayOrder, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-6">
            @Html.EditorFor(model => model.DisplayOrder, new { htmlAttributes = new { @class = "form-control", id = "displayOrder" } })
            @Html.ValidationMessageFor(model => model.DisplayOrder, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.IsAssigned, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-6">
            @Html.CheckBoxFor(model => model.IsAssigned, new { htmlAttributes = new { @class = "form-control", id="IsAssigned" } })
            @Html.ValidationMessageFor(model => model.IsAssigned, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="col-md-9">
        <div class="col-md-6 col-lg-offset-6">
            <a href="#" class="btn btn-success" onclick="AddAttributePair()">Associate Attribute &amp; it's Value with Category</a>
        </div>

    </div>

</div>

<hr />
<div class="form-group">
    <div class="col-md-12">
        @{
            Html.RenderAction("CategoryAttributeListByCategoryId", "CategoryAttributePair");// , new { id = ViewBag.CategoryID }
        }
    </div>
</div>


<script>
    var AddAttributePair = function () {

        var attributeId = $("#cmbAttribute option:selected").val();
        var attributeTitle = $("#cmbAttribute option:selected").text();
        var AttributeValue = $("#attributeValue").val();
        var DisplayOrder = $("#displayOrder").val();
        var IsAssigned = $("#IsAssigned").val();

        var form = $('#__AjaxAntiForgeryForm');
        var token = $('input[name="__RequestVerificationToken"]', form).val();

        var myData = {
            AttributeID: attributeId, 
            CategoryID: @ViewContext.RouteData.Values["id"].ToString(),
            AttributeValue: AttributeValue,
            DisplayOrder: DisplayOrder,
            IsAssigned: IsAssigned,
            "__RequestVerificationToken": token
        }
        $.ajax({
            type: "POST",
            url: "/Admin/CategoryAttributePair/AssociateAttributeWithCategory/",
            data: myData ,
            success: function (result) {
                if(result == undefined || result == "")
                {
                    alert('unable to associate attribute with category. Please retry.');
                    return;
                }
                else
                {
                    var newRow =
                        "<tr id='" + result + "'>" +
                            "<td class='hidden'>" + result + "</td>" +
                            "<td>" + attributeTitle + "</td>" +
                            "<td>" + myData.AttributeValue + "</td>" +
                            "<td>" + myData.DisplayOrder + "</td>" +
                            "<td>" + "<input class='check-box' checked='" + myData.IsAssigned + "' disabled='disabled' type='checkbox'/>" + "</td>" + // myData.IsAssigned + "</td>"
                            "<td>" +
                                        "<a href = '/Admin/CategoryAttributePair/Edit/" + result +
                                                "' class='btn btn-xs btn-default' data-toggle='tooltip' data-placement='top' title='Edit'><i class='glyphicon glyphicon-pencil'></i></a> " +
                            "</td>" +
                        "</tr> ";
                    //alert(newRow);
                    $('#CategoryAttributePairTable').append(newRow);
                    $("#attributeValue").val('');
                    $("#displayOrder").val('');
                    $("#IsAssigned").checked = false; //('');
                    //$("#cmbAttribute option:selected").remove();
                }
            }
        });
    }
    var OnModalClose = function (newAttribute){
        var option = new Option(newAttribute.AttributeTitle, newAttribute.AttributeID);
        $('#cmbAttribute').append($(option));
        $("#cmbAttribute").val(newAttribute.AttributeID);
        $("#attributeValue").focus();
        @*var mydata = {
            AttributeID: newAttribute.AttributeID,
            CategoryID: @ViewContext.RouteData.Values["id"].ToString(),
        };
        $.ajax({
            type: "POST",
            url: "/Admin/CategoryAttributePair/AssociateAttributeWithCategory/",
            data: mydata,
            success: function (newCategoryAttributePair) {
                $("#loaderDiv").hide();
                $("#attributeCreateModal").modal("hide");
                var newRow = "<tr id='" + newCategoryAttributePair.CategoryAttributePairID + "'><td class='hidden'>" + newCategoryAttributePair.CategoryAttributePairID + "</td><td>" + newCategoryAttributePair.AttributeTitle +
                             "</td><td><a href='/Admin/CategoryAttributePair/Delete/" + newCategoryAttributePair.CategoryAttributePairID + "'>Delete</a></td></tr>";
                $('#CategoryAttributePairTable').append(newRow);

            }
        })*@
    }
</script>
