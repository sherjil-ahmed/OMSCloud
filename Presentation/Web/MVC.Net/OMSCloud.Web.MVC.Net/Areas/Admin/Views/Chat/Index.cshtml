                                    {
                                        <span>Active</span>
                                    }
                                    else if (item.StatusId == (long)DBStatusEnum.InActive)
                                    {
                                        <span>In-Active</span>
                                    }
                                    else if (item.StatusId == (long)DBStatusEnum.Deleted)
                                    {
                                        <span>Deleted</span>
                                    }
                                </td>
