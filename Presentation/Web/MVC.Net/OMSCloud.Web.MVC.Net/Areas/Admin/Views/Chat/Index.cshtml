                                    <td>
                                        @Html.DisplayFor(modelItem => item.ModifiedBy)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.ModifiedOn)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.ChatId)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.ChatCode)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.ProfileId1)
                                    </td>*@
                                <td>
                                    @Html.DisplayFor(modelItem => item.ProfileId1_Name)
                                </td>
                                @*<td>
                                        @Html.DisplayFor(modelItem => item.ProfileId1_Image)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.ProfileId2)
                                    </td>*@
                                <td>
                                    @Html.DisplayFor(modelItem => item.ProfileId2_Name)
                                </td>
                                <td>
                                    @if (item.StatusId == (long)DBStatusEnum.New)
                                    {
                                        <span>New</span>
                                    }
