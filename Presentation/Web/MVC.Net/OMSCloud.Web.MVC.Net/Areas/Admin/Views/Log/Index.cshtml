@model IEnumerable<OMSCloud.Contracts.ViewModels.LogModel>

@{
    ViewBag.Title = "Index";
}
<p>
    @*@Html.ActionLink("Create New", "Create")*@
    <a href="@Url.Action("Create")" class="btn btn-md btn-default"><i class="glyphicon glyphicon-plus"></i> Create New</a>
</p>
<table class="table table-striped table-bordered dataTable" style="width:100%">
    <thead>
        <tr>
            <th class="hidden">
                @Html.DisplayNameFor(model => model.RequestedByProfileId)
            </th>
            <th class="hidden">
                @Html.DisplayNameFor(model => model.CreatedBy)
            </th>
            <th class="hidden">
                @Html.DisplayNameFor(model => model.CreatedOn)
            </th>
            <th class="hidden">
                @Html.DisplayNameFor(model => model.ModifiedBy)
            </th>
            <th class="hidden">
                @Html.DisplayNameFor(model => model.ModifiedOn)
            </th>
            <th class="hidden">
                @Html.DisplayNameFor(model => model.LogLevelId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ShortMessage)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FullMessage)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IpAddress)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CustomerId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PageUrl)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReferrerUrl)
            </th>
            <th></th>
        </tr>
    </thead>

  <tbody>
      @foreach (var item in Model)
      {
          <tr>
              <td class="hidden">
                  @Html.DisplayFor(modelItem => item.RequestedByProfileId)
              </td>
              <td class="hidden">
                  @Html.DisplayFor(modelItem => item.CreatedBy)
              </td>
              <td class="hidden">
                  @Html.DisplayFor(modelItem => item.CreatedOn)
              </td>
              <td class="hidden">
                  @Html.DisplayFor(modelItem => item.ModifiedBy)
              </td>
              <td class="hidden">
                  @Html.DisplayFor(modelItem => item.ModifiedOn)
              </td>
              <td class="hidden">
                  @Html.DisplayFor(modelItem => item.LogLevelId)
              </td>
              <td>
                  @Html.DisplayFor(modelItem => item.ShortMessage)
              </td>
              <td>
                  @Html.DisplayFor(modelItem => item.FullMessage)
              </td>
              <td>
                  @Html.DisplayFor(modelItem => item.IpAddress)
              </td>
              <td>
                  @Html.DisplayFor(modelItem => item.CustomerId)
              </td>
              <td>
                  @Html.DisplayFor(modelItem => item.PageUrl)
              </td>
              <td>
                  @Html.DisplayFor(modelItem => item.ReferrerUrl)
              </td>
              <td>
                  @*@Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
                  @Html.ActionLink("Details", "Details", new { id = item.Id }) |
                  @Html.ActionLink("Delete", "Delete", new { id = item.Id })*@
                  <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-xs btn-default" data-toggle="tooltip" data-placement="top" title="Edit"><i class="glyphicon glyphicon-pencil"></i></a>
                  <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-xs btn-info" data-toggle="tooltip" data-placement="top" title="Details"><i class="glyphicon glyphicon-eye-open"></i></a>
                  <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-xs btn-danger" data-toggle="tooltip" data-placement="top" title="Delete"><i class="glyphicon glyphicon-remove-sign"></i></a>
              </td>
          </tr>
      }
  </tbody>

</table>
