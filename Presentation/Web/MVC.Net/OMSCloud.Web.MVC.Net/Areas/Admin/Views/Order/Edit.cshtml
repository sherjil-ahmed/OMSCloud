<script src="~/Scripts/jquery-3.1.1.min.js"></script>

<script>
    var SetNextStatus = function () {
        if(@ViewBag.DefaultOrderStatusIndex != -1)
            $("#OrderStatusId")[0].selectedIndex = @ViewBag.DefaultOrderStatusIndex;
    };
    var ResetToUnchangedStatus = function () {
        if(@ViewBag.CurrentOrderStatusIndex != -1)
            $("#OrderStatusId")[0].selectedIndex = @ViewBag.CurrentOrderStatusIndex;
    };

    function FillPayMode() {
        var payTypeId = $('#PayTypeId').val();
        $.ajax({
            url: '/Admin/CartOrder/FillPayMode',
            type: "GET",
            dataType: "JSON",
            data: { PayTypeId: payTypeId },
            success: function (payModeList) {
                var payModeId = $("#PayModeId");
                $("#PayModeId").html(""); // clear before appending new list
                $.each(payModeList, function (i, payMode) {
                    $("#PayModeId").append(
                        $('<option></option>').val(payMode.PayModeID).html(payMode.PayModeTitle));
                });
            }
        });
    }


</script>
