
@model IEnumerable<OMSCloud.Contracts.ViewModels.ScheduleDisplayModel>

<table class="table table-striped table-hover table-responsive table-bordered dataTable" style="width:100%">
    <thead>
        <tr>
            <th class="hidden">
                @Html.DisplayNameFor(model => model.ScheduleID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ShopName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ScheduleTypeTitle)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsException)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FromDay)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ToDay)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Month)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MonthDay)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WeekDays)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StatusID)
            </th>
            @*<th>
                    @Html.DisplayNameFor(model => model.Notes)
                </th>*@

        </tr>
    </thead>
    <tbody>
        @if (Model != null)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td class="hidden">
                        @Html.DisplayFor(modelItem => item.ScheduleID)
                    </td>
                    <td>
                        <a href="@Url.Action("Edit", new { id = item.ScheduleID })" style="color:#000" data-toggle="tooltip" data-placement="top" <i>@Html.DisplayFor(modelItem => item.ShopName)</i>

                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ScheduleTypeTitle)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.IsException)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.FromDay)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ToDay)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Month)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.MonthDay)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.WeekDays)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.StatusTitle)
                    </td>

                </tr>
            }
        }
    </tbody>
</table>
