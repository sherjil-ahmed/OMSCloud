<script>

    $('#file').on('change', function (e) {
        //alert('sdfsdfsfsf');
        var files = e.target.files;
        var productId =@ViewContext.RouteData.Values["id"].ToString();
        if (files.length > 0) {

            var form = $('#__AjaxAntiForgeryForm');
            var token = $('input[name="__RequestVerificationToken"]', form).val();

            var data = new FormData();
            data.append("file", files[0]);
            data.append("productId", productId);
            data.append("__RequestVerificationToken", token);
            //console.log(data);
            $.ajax({
                type: "POST",
                url: '@Url.Action("CreateMediaContentDetail", "ProductMediaDetail")',
                contentType: false,
                processData: false,
                data: data,
                success: function (data) {
                    model.MediaFilePath = data;
                    //var newRow = "<li><a href='#' >" +
                    //"<img src='http://localhost:8749/DynamicContent/UploadedImages/ProductMediaDetail/data.ProductMediaID/data.MediaFilePath' class='img-responsive' id='targetImg' width='200' height='200' />" + 
                    //"</a>    </li>";

                    //$('#productImageList').append(newRow);

                },
                error: function () {

                }

            });
        }
    });
</script>
