@model OMSCloud.Contracts.ViewModels.ProductMediaDetailModel

<form id="ProductMediaDetailForm">
    <div class="form-horizontal">

        <div class="form-group hidden">
            @Html.LabelFor(model => model.ProductMediaID, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-6">
                @Html.EditorFor(model => model.ProductMediaID, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.ProductMediaID, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group hidden">
            @Html.LabelFor(model => model.ProductMediaTitle, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-6">
                @Html.EditorFor(model => model.ProductMediaTitle, new { htmlAttributes = new { @class = "form-control", id = "productMediaTitle" } })
                @Html.ValidationMessageFor(model => model.ProductMediaTitle, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group hidden">
            @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-6">
                @Html.EditorFor(model => model.Description, new { htmlAttributes = new { @class = "form-control", @id = "descre", @rows = "8" } })
                @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group hidden">
            @Html.LabelFor(model => model.MediaContentTypeTitle, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-6">
                @Html.DropDownListFor(model => model.MediaContentTypeID, ViewBag.MediaContentType as SelectList, "--Please Select--", new { @class = "form-control", id = "mediaContentTypeID" })
                @Html.ValidationMessageFor(model => model.MediaContentTypeID, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group hidden">
            @Html.LabelFor(model => model.Width, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-6">
                @Html.EditorFor(model => model.Width, new { htmlAttributes = new { @class = "form-control", id = "width", @type = "number" } })
                @Html.ValidationMessageFor(model => model.Width, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group hidden">
            @Html.LabelFor(model => model.Height, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-6">
                @Html.EditorFor(model => model.Height, new { htmlAttributes = new { @class = "form-control", id = "height", @type = "number" } })
                @Html.ValidationMessageFor(model => model.Height, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group hidden">
            @Html.LabelFor(model => model.TransparencyLevel, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-6">
                @Html.EditorFor(model => model.TransparencyLevel, new { htmlAttributes = new { @class = "form-control", id = "transparencyLevel", @type = "number" } })
                @Html.ValidationMessageFor(model => model.TransparencyLevel, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group hidden">
            @Html.LabelFor(model => model.StatusTitle, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-6">
                @Html.DropDownListFor(model => model.StatusID, ViewBag.Status as SelectList, "--Please Select--", new { @class = "form-control", id = "statusID" })
                @Html.ValidationMessageFor(model => model.StatusID, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelForModel( "Add new Product Image", htmlAttributes: new { @class = "control-label col-md-2", id = "mediaFilePath" })
            <div class="col-md-6">
                <div class="btn btn-facebook">
                    <input type="file" id="file" name="file" multiple="multiple" class="input-files" />
                </div>
                
                <div id="imgPreview" class="thumbnail" style="display:none">
                    <img class="img-responsive" id="targetImg" />
                    <div class="caption">
                        <a href="#" onclick="ClearPreview()"><i class="glyphicon glyphicon-trash"></i></a>
                        <span id="description"></span>
                    </div>
                </div>
            </div>
        </div>


