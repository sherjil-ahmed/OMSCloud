@model IEnumerable<OMSCloud.Contracts.ViewModels.ProductMediaDetailModel>
@{
    ViewBag.Title = "Product-Media List";

}
<div class="panel panel-default">
    <div class="panel-heading">
        @*@Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-md btn-default" })*@
        <a href="@Url.Action("Create")" class="btn btn-md btn-default"><i class="glyphicon glyphicon-plus"></i> Create New</a>
    </div>
    <div class="panel-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover table-responsive table-bordered dataTable" style="width:100%">
                <thead>
                    <tr>
                        <th class="hidden">
                            @Html.DisplayNameFor(model => model.ProductMediaID)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.ProductTitle)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.ProductMediaTitle)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.MediaContentTypeTitle)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Width)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Height)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.TransparencyLevel)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.StatusTitle)
                        </th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                        <tr>
                            <td class="hidden">
                                @Html.DisplayFor(modelItem => item.ProductMediaID)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ProductTitle)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ProductMediaTitle)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.MediaContentTypeTitle)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Width)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Height)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.TransparencyLevel)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.StatusTitle)
                            </td>

                            <td>
                                @*@Html.ActionLink("Edit", "Edit", new { id = item.ProductMediaID }) |
                                    @Html.ActionLink("Details", "Details", new { id = item.ProductMediaID }) |
                                    @Html.ActionLink("Delete", "Delete", new { id = item.ProductMediaID })*@
                                <a href="@Url.Action("Edit", new { id = item.ProductMediaID })" class="btn btn-xs btn-default" data-toggle="tooltip" data-placement="top" title="Edit"><i class="glyphicon glyphicon-pencil"></i></a>
                                <a href="@Url.Action("Details", new { id = item.ProductMediaID })" class="btn btn-xs btn-info" data-toggle="tooltip" data-placement="top" title="Details"><i class="glyphicon glyphicon-eye-open"></i></a>
                                <a href="@Url.Action("Delete", new { id = item.ProductMediaID })" class="btn btn-xs btn-danger" data-toggle="tooltip" data-placement="top" title="Delete"><i class="glyphicon glyphicon-remove-sign"></i></a>
                            </td>
                        </tr>
                        }
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>
