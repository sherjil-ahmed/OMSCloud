@{
    Layout = null;

}
<!doctype html>
<html class="fixed">


<head>

    <!-- Basic -->
    <meta charset="UTF-8">
    <title>Dashboard | Zvonr Admin - Best Shopping Experience ever - Powered by AvatureBytes.com</title>
    <meta name="keywords" content="e-Commerce online shopping web portal avanturebytes avanturebytes.com" />
    <meta name="description" content="Zvonr Admin Panel by avanturebytes.com">
    <meta name="author" content="www.avanturebytes.com">

    <!-- Mobile Metas -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />

    <!-- Web Fonts  -->
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700,800|Shadows+Into+Light" rel="stylesheet" type="text/css">

    <!-- Vendor CSS -->
    <link rel="stylesheet" href="~/Areas/admin/contents/assets/vendor/bootstrap/css/bootstrap.css" />

    <link rel="stylesheet" href="~/Areas/admin/contents/assets/vendor/font-awesome/css/font-awesome.css" />
    <link rel="stylesheet" href="~/Areas/admin/contents/assets/vendor/magnific-popup/magnific-popup.css" />
    <link rel="stylesheet" href="~/Areas/admin/contents/assets/vendor/bootstrap-datepicker/css/bootstrap-datepicker3.css" />

    <!-- Theme CSS -->
    <link rel="stylesheet" href="~/Areas/admin/contents/assets/stylesheets/theme.css" />

    <!-- Theme Custom CSS -->
    <link rel="stylesheet" href="~/Areas/admin/contents/assets/stylesheets/theme-custom.css">
    <link rel="stylesheet" href="~/Areas/admin/contents/assets/stylesheets/custom.css">

    <!-- Head Libs -->
    <script src="~/Areas/admin/contents/assets/vendor/modernizr/modernizr.js"></script>
    <script src="~/Areas/admin/contents/assets/vendor/style-switcher/style.switcher.localstorage.js"></script>

</head>
<body style="background-color: white;">
    <section class="body-sign">
        <div class="center-sign">
            <a href="../../" class="logo pull-left">
                <img src="~/Areas/admin/contents/assets/images/logo.png" style ="height: 70px; width: 250px" alt="OMS Admin" />
            </a>
            <div class="panel panel-sign">
                <div class="panel-title-sign mt-xl text-right">
                    <h2 class="title text-uppercase text-weight-bold m-none"><i class="fa fa-user mr-xs"></i> @ViewBag.AuthTitle</h2>
                </div>
                <div class="panel-body"  style="background-color: #ecedf0">
                    @RenderBody()

                </div>
            </div>
            <p class="text-center text-muted mt-md mb-md"><a href="http://www.avanturebytes.com" style="color: blue">  AvantureBytes </a> &copy; Copyright @DateTime.Now.Year. All Rights Reserved.</p>
        </div>
    </section>
    <!-- Vendor -->
    <script src="~/Areas/admin/contents/assets/vendor/jquery/jquery.js"></script>
    <script src="~/Areas/admin/contents/assets/vendor/jquery-browser-mobile/jquery.browser.mobile.js"></script>
    <script src="~/Areas/admin/contents/assets/vendor/jquery-cookie/jquery-cookie.js"></script>
    <script src="~/Areas/admin/contents/assets/vendor/style-switcher/style.switcher.js"></script>
    <script src="~/Areas/admin/contents/assets/vendor/bootstrap/js/bootstrap.js"></script>
    <script src="~/Areas/admin/contents/assets/vendor/nanoscroller/nanoscroller.js"></script>
    <script src="~/Areas/admin/contents/assets/vendor/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
    <script src="~/Areas/admin/contents/assets/vendor/magnific-popup/jquery.magnific-popup.js"></script>
    <script src="~/Areas/admin/contents/assets/vendor/jquery-placeholder/jquery-placeholder.js"></script>

    <!-- Theme Base, Components and Settings -->
    <script src="~/Areas/admin/contents/assets/javascripts/theme.js"></script>

    <!-- Theme Custom -->
    <script src="~/Areas/admin/contents/assets/javascripts/theme.custom.js"></script>

    <!-- Theme Initialization Files -->
    <script src="~/Areas/admin/contents/assets/javascripts/theme.init.js"></script>
    <!-- Analytics to Track Preview Website -->
    <script>(function (i, s, o, g, r, a, m) { i['GoogleAnalyticsObject'] = r; i[r] = i[r] || function () { (i[r].q = i[r].q || []).push(arguments) }, i[r].l = 1 * new Date(); a = s.createElement(o), m = s.getElementsByTagName(o)[0]; a.async = 1; a.src = g; m.parentNode.insertBefore(a, m) })(window, document, 'script', '../../../www.google-analytics.com/analytics.js', 'ga'); ga('create', 'UA-42715764-8', 'auto'); ga('send', 'pageview');</script>
</body>

</html>