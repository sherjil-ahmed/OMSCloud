<div class="modal fade" id="@ViewData["modalDivId"].ToString()">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <a href="#" class="close" data-dismiss="modal">&times;</a>
                <h3 class="modal-title">@ViewData["Title"].ToString()</h3>
            </div>
            <div class="modal-body" id="@ViewData["modalBodyId"].ToString()">
                Are you sure you want to delete this item?
                <br/>
                <button class="btn btn-danger" onclick="onModalDelete()" value="Yes">Delete</button>
                <button class="btn btn-success" onclick="onCancel()" value="No">No</button>
            </div>
        </div>
    </div>

</div>

<script>
    function onModalDelete()
    {
        var url = "@ViewData["URL"].ToString()";
        console.log('url=> ',url)
        //$('#@ViewData["modalDivId"].ToString()').modal("hide")
        $.ajax({
            type: "POST",
            url: url,
            success: function ()
            {
                $('#@ViewData["modalDivId"].ToString()').modal("hide")
                window.location.href = url.slice(0, url.indexOf('/', 7))
            }
        })
    }
    function onCancel()
    {
        $('#@ViewData["modalDivId"].ToString()').modal("hide")
    }
    function ShowModal()
    {
        $('#@ViewData["modalDivId"].ToString()').modal("show")
    }
</script>