<div class="modal fade" id="@ViewData["modalDivId"].ToString()">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <a href="#" class="close" data-dismiss="modal">&times;</a>
                <h3 class="modal-title">@ViewData["Title"].ToString()</h3>
            </div>
            <div class="modal-body" id="@ViewData["modalBodyId"].ToString()">
                Not Authorized
                <br />
                <button class="btn btn-success" onclick="onCancel()" value="No">Ok</button>
            </div>
        </div>
    </div>

</div>

<script>
    function onCancel()
    {
        $('#@ViewData["modalDivId"].ToString()').modal('hide')
    }
    function ShowModal()
    {
        $('#@ViewData["modalDivId"].ToString()').modal('show')
    }
</script>
