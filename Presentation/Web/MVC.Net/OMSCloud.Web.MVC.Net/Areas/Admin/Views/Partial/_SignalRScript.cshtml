@using OMSCloud.Contracts.Common.ConfigMgmt
@{ 
    var url = "http://localhost:8749/signalr";
    var url2 = "http://localhost:8749/SignalR/hubs";
    if (! string.IsNullOrEmpty(ApplicationSession.Country) )
    {
        url = Config.GetWebAPIHost(ApplicationSession.Country) + "/signalr";
        url2 = Config.GetWebAPIHost(ApplicationSession.Country) + "/SignalR/hubs";
    }

    var profileID = "-1";
    if( ! string.IsNullOrEmpty(ApplicationSession.Secure_ProfileId))
    {
        profileID = ApplicationSession.Secure_ProfileId;
    }


}
    <!--Script references. -->
    <!--The jQuery library is required and is referenced by default in _Layout.cshtml. -->
    <!--Reference the SignalR library. -->
    @*<script src="~/Scripts/jquery-1.6.4.min.js"></script>*@
    <script src="~/Scripts/jquery.signalR-2.4.1.js"></script>
    <!--Reference the autogenerated SignalR hub script. -->
    <script src="@url2"></script>
    <!--SignalR script to update the chat page and send messages.-->
    <script>        
        $(function () {
            // Reference the auto-generated proxy for the hub.
            //alert('a');
            var notification = $.connection.notificationHub;
            //console.log(chat);
            $.connection.hub.url = '@url';
            $.connection.hub.qs = { 'ProfileID': '@profileID' };
            // Create a function that the hub can call back to display messages.
            notification.client.broadCastMessage = function (message) {
                // Add the message to the page.
                //alert(message.Message);
                requestAndShowPermission(message);
            };
            $.connection.hub.start().done(function () {
                console.log('connected');
            }).fail(function (a) {
                console.log('not connected' + a);
            });
        });
        
        let permission = Notification.permission;
        if (permission === "granted") {
            //showNotification();
        } else if (permission === "default") {
            //requestAndShowPermission();
        } else {
            //alert("Use normal alert");
        }
        function showNotification(message) {
            if (document.visibilityState === "visible") {
                return;
            }
            var title = "";
            if (message.NotificationType == "1") {
                title = "General Notification"
            }
            else if (message.NotificationType == "2") {
                title = "Chat Notification"
            }
            else if (message.NotificationType == "3") {
                title = "Order Notification"
            }
            else if (message.NotificationType == "4") {
                title = "Review Notification"
            }
            
            icon = "/Areas/admin/Contents/assets/images/logo.png"
            var body = message.Message;
            var notification = new Notification(title, { body, icon });
            notification.onclick = () => {
                notification.close();
                window.parent.focus();
            }
        }
        function requestAndShowPermission(message) {
            Notification.requestPermission(function (permission) {
                if (permission === "granted") {
                    showNotification(message);
                }
            });
        }
    </script>
