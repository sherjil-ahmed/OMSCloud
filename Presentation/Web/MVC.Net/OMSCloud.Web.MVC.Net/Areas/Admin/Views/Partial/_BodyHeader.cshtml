@using OMSCloud.Web.MVC.Net.Areas.Security;
@using OMSCloud.Web.MVC.Net.Areas.Security.Models;
@using Microsoft.AspNet.Identity;

@model OMSCloud.Contracts.ViewModels.CountryLookupModel

<header class="header">
    <div class="logo-container">
        <a href="../../" class="logo">
            <img src="~/Areas/admin/Contents/assets/images/logo.png" style ="height: 56px; width: 225px;" alt="OMS Admin" />
        </a>
        <div class="visible-xs toggle-sidebar-left" data-toggle-class="sidebar-left-opened" data-target="html" data-fire-event="sidebar-left-opened">
            <i class="fa fa-bars" aria-label="Toggle sidebar"></i>
        </div>
    </div>

    <!-- start: search & user box -->
    <div class="header-right">

        <form action="" class="search nav-form hidden">
            <div class="input-group input-search">
                <input type="text" class="form-control" name="q" id="q" placeholder="Search...">
                <span class="input-group-btn">
                    <button class="btn btn-default" type="submit"><i class="fa fa-search"></i></button>
                </span>
            </div>
        </form>
        @if (Model != null)
        {
            <script type='text/javascript'>
                function submitForm() {
                    $('#ChangeCountryForm').submit();
                }
            </script>

            @*using (Html.BeginForm("ChangeCountry", "Home", FormMethod.Post, htmlAttributes: new { id = "ChangeCountryForm", enctype = "multipart/form-data", @class = "search nav-form" }))
            {
                @Html.AntiForgeryToken()
                @Html.EnumDropDownListFor(model => model.CountryName, "Select Country", new { id = "HeaderCountry", @class = "form-control", onchange = "submitForm()" })
            }*@
            @*@Html.ActionLink("Clear Cache", "ClearCache", "Home", new { @class = "btn btn-success" });*@
        }
        <span class="separator"></span>

        <ul class="notifications">
            <li class="hidden">
                <a href="#" class="dropdown-toggle notification-icon" data-toggle="dropdown">
                    <i class="fa fa-tasks"></i>
                    <span class="badge">3</span>
                </a>

                <div class="dropdown-menu notification-menu large">
                    <div class="notification-title">
                        <span class="pull-right label label-default">3</span>
                        Tasks
                    </div>

                    <div class="content">
                        <ul>
                            <li>
                                <p class="clearfix mb-xs">
                                    <span class="message pull-left">Generating Sales Report</span>
                                    <span class="message pull-right text-dark">60%</span>
                                </p>
                                <div class="progress progress-xs light">
                                    <div class="progress-bar" role="progressbar" aria-valuenow="60" aria-valuemin="0" aria-valuemax="100" style="width: 60%;"></div>
                                </div>
                            </li>

                            <li>
                                <p class="clearfix mb-xs">
                                    <span class="message pull-left">Importing Contacts</span>
                                    <span class="message pull-right text-dark">98%</span>
                                </p>
                                <div class="progress progress-xs light">
                                    <div class="progress-bar" role="progressbar" aria-valuenow="98" aria-valuemin="0" aria-valuemax="100" style="width: 98%;"></div>
                                </div>
                            </li>

                            <li>
                                <p class="clearfix mb-xs">
                                    <span class="message pull-left">Uploading something big</span>
                                    <span class="message pull-right text-dark">33%</span>
                                </p>
                                <div class="progress progress-xs light mb-xs">
                                    <div class="progress-bar" role="progressbar" aria-valuenow="33" aria-valuemin="0" aria-valuemax="100" style="width: 33%;"></div>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </li>
            <li>
                <a href="#" class="dropdown-toggle notification-icon" data-toggle="dropdown">
                    <i style=" line-height: 27px;"><img src="~/Areas/admin/Contents/assets/images/@ViewBag.Country-flag.png" alt="fa fa-flag" class="img-circle" style="width: 26px; height: 26px; color: transparent;" /></i>
                    @*<span class="badge">4</span>*@
                </a>

                <div class="dropdown-menu notification-menu">
                    <div class="notification-title">
                        <span class="pull-right label label-default">@ViewBag.Country</span>
                        Country Selection
                    </div>

                    <div class="content">
                        <ul>
                            <li class="">
        
                                <a href="@Url.Action("ChangeCountryDropDown", "Home", new { Id = 1 })" class="clearfix">
                                    <figure class="image">
                                        <img src="~/Areas/admin/Contents/assets/images/canada-flag.png" alt="Canada" class="img-circle"  style="width: 35px; height: 35px; color: transparent;"/>
                                    </figure>
                                    <span class="title">Canada</span>
                                    <span class="message">Canada</span>
                                </a>
                            </li>
                            <li>
                                <a href="@Url.Action("ChangeCountryDropDown", "Home", new { Id = 2 })" class="clearfix">
                                    <figure class="image" style="width: 35px; height: 35px; color: transparent;">
                                        <img src="~/Areas/admin/Contents/assets/images/usa-flag.png" alt="USA" class="img-circle"  style="width: 35px; height: 35px; color: transparent;"/>
                                    </figure>
                                    <span class="title">USA</span>
                                    <span class="message truncate">United States of America</span>
                                </a>
                            </li>
                            <li >
                                <a href="@Url.Action("ChangeCountryDropDown", "Home", new { Id = 3 })" class="clearfix">
                                    <figure class="image" style="width: 35px; height: 35px; color: transparent;">
                                        <img src="~/Areas/admin/Contents/assets/images/uk-flag.png" alt="UK" class="img-circle"  style="width: 35px; height: 35px; color: transparent;"/>
                                    </figure>
                                    <span class="title">United Kingdom</span>
                                    <span class="message">Great British Kingdom</span>
                                </a>
                            </li>
                            @*<li>
                                <a href="@Url.Action("ChangeCountryDropDown", "Home", new { Id = 4 })" class="clearfix">
                                    <figure class="image">
                                        <img src="~/Areas/admin/Contents/assets/images/australia-flag.png" alt="Australia" class="img-circle" style="width: 35px; height: 35px; color: transparent;"/>
                                    </figure>
                                    <span class="title">Australia</span>
                                    <span class="message">Australia</span>
                                </a>
                            </li>*@
                        </ul>

                        <hr class="hidden" />

                        <div class="text-right hidden">
                            <a href="#" class="view-more">View All</a>
                        </div>
                    </div>
                </div>
            </li>
            <li>
                <a href="#" class="dropdown-toggle notification-icon" data-toggle="dropdown">
                    <i style=" line-height: 27px;"><img src="~/Areas/admin/Contents/assets/images/settings.png" alt="fa fa-cogs" class="img-circle" style="width: 26px; height: 26px; color: transparent; line-height: 27px;" /></i>
                    @*<span class="badge">0</span>*@
                </a>

                <div class="dropdown-menu notification-menu">
                    <div class="notification-title">
                        <span class="pull-right label label-default">0</span>
                        System Settings
                    </div>

                    <div class="content">
                        <ul>
                            <li>
                                <a href="@Url.Action("ClearCache", "Home")" class="clearfix">
                                    <div class="image">
                                        @*<i class="fa fa-sync bg-success"></i>*@
                                        <i><img src="~/Areas/admin/Contents/assets/images/refresh.png" alt="fa fa-cogs" class="img-circle" style="width: 26px; height: 26px; color: transparent; line-height: 27px;" /></i>
                                    </div>
                                    <span class="title">Clear Cache</span>
                                    <span class="message">Reset All cached data </span>
                                </a>
                            </li>
                            <li>
                                <a href="@Url.Action("ClearLocationFilter", "Home")" class="clearfix">
                                    <div class="image">
                                        @*<i class="fa fa-sync bg-success"></i>*@
                                        <i><img src="~/Areas/admin/Contents/assets/images/refresh.png" alt="fa fa-cogs" class="img-circle" style="width: 26px; height: 26px; color: transparent; line-height: 27px;" /></i>
                                    </div>
                                    <span class="title">Reset Location Filter</span>
                                    <span class="message">Reset Province and City Filter</span>
                                </a>
                            </li>
                            
                            <li class="hidden">
                                <a href="#" class="clearfix">
                                    <div class="image">
                                        <i class="fa fa-lock bg-warning"></i>
                                    </div>
                                    <span class="title">User Locked</span>
                                    <span class="message">15 minutes ago</span>
                                </a>
                                @*@if (Model != null)
            {
                <script type='text/javascript'>
                    function submitForm() {
                        $('#ChangeCountryForm').submit();
                    }
                </script>

                using (Html.BeginForm("ChangeCountry", "Home", FormMethod.Post, htmlAttributes: new { id = "ChangeCountryForm", enctype = "multipart/form-data", @class = "search nav-form" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.EnumDropDownListFor(model => model.CountryName, "Select Country", new { id = "HeaderCountry", @class = "form-control", onchange = "submitForm()" })
                }
            }*@
                            </li>
                            <li class="hidden">
                                <a href="#" class="clearfix">
                                    <div class="image">
                                        <i class="fa fa-signal bg-success"></i>
                                    </div>
                                    <span class="title">Connection Restaured</span>
                                    <span class="message">10/10/2014</span>
                                </a>
                            </li>
                        </ul>

                        <hr  class="hidden"/>

                        <div class="text-right hidden">
                            <a href="#" class="view-more">View All</a>
                        </div>
                    </div>
                </div>
            </li>
        </ul>

        <span class="separator"></span>

        @{
            try
            {
                //Html.RenderPartial("~/Areas/Admin/Views/Partial/_UserBox.cshtml", ApplicationUserManager.GetUser(User.Identity.GetUserId<long>()));
                Html.RenderAction("GetUserBox", "Home", new { area = "Admin" });
            }
            catch (Exception ex)
            {
                var str = ex.Message;
            }
        }

    </div>
    <!-- end: search & user box -->

</header>
