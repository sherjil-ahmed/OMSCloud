@model IEnumerable<OMSCloud.Contracts.ViewModels.NotifyModel>
@using OMSCloud.Contracts.Common
@using OMSCloud.Contracts.Common.DBEnums

@{
    ViewBag.Title = "List of All Notification Received by Admin";
}

<div class="panel panel-default">
    @*<div class="panel-heading">
        </div>*@
    <div class="panel-body">
            <table class="table table-striped table-hover table-responsive table-bordered dataTable">
                <thead>
                    <tr>
                        <th class="hidden">
                            @Html.DisplayNameFor(model => model.RequestedByProfileId)
                        </th>
                        <th class="hidden">
                            @Html.DisplayNameFor(model => model.CreatedBy)
                        </th>
                        <th class="hidden">
                            @Html.DisplayNameFor(model => model.CreatedOn)
                        </th>
                        <th class="hidden">
                            @Html.DisplayNameFor(model => model.ModifiedBy)
                        </th>
                        <th class="hidden">
                            @Html.DisplayNameFor(model => model.ModifiedOn)
                        </th>
                        <th class="hidden">
                            @Html.DisplayNameFor(model => model.NotificationId)
                        </th>
                        <th>
                            View details
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.SenderProfileName)
                        </th>
                        <th class="hidden">
                            @Html.DisplayNameFor(model => model.ReceiverProfileId)
                        </th>
                        <th class="hidden">
                            @Html.DisplayNameFor(model => model.StatusId)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Message)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.NotificationType)
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                    <tr>
                        <td class="hidden">
                            @Html.DisplayFor(modelItem => item.RequestedByProfileId)
                        </td>
                        <td class="hidden">
                            @Html.DisplayFor(modelItem => item.CreatedBy)
                        </td>
                        <td class="hidden">
                            @Html.DisplayFor(modelItem => item.CreatedOn)
                        </td>
                        <td class="hidden">
                            @Html.DisplayFor(modelItem => item.ModifiedBy)
                        </td>
                        <td class="hidden">
                            @Html.DisplayFor(modelItem => item.ModifiedOn)
                        </td>
                        <td class="hidden">
                            @Html.DisplayFor(modelItem => item.NotificationId)
                        </td>
                        <td>
                            @if (item.NotificationType == (long)NotificationTypeEnum.Product)
                            {
                                <a href='@Url.Action("Edit", "Product", new { Id = item.SubjectRowID })' class='btn btn-md btn-default'>
                                    <i class='glyphicon glyphicon-arrow-right'> View Product: Id = @item.SubjectRowID</i>
                                </a>
                            }
                            @if (item.NotificationType == (long)NotificationTypeEnum.Shop)
                            {
                                <a href="@Url.Action("Edit", "Supplier",new { Id=item.SubjectRowID})" class="btn btn-md btn-default">
                                    <i class='glyphicon glyphicon-arrow-right'> View Shop: Id = @item.SubjectRowID</i>
                                </a>
                            }
                            @if (item.NotificationType == (long)NotificationTypeEnum.Order)
                            {
                                <a href="@Url.Action("Edit", "Order",new { Id=item.SubjectRowID} )" class="btn btn-md btn-default">
                                    <i class='glyphicon glyphicon-arrow-right'> View Order: Id = @item.SubjectRowID</i>
                                </a>
                            }
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.SenderProfileName)
                        </td>
                        <td class="hidden">
                            @Html.DisplayFor(modelItem => item.ReceiverProfileId)
                        </td>
                        <td class="hidden">
                            @*@if (item.StatusId == (long)DBStatusEnum.New)
            {
                <span>New</span>
            }
            else if (item.StatusId == (long)DBStatusEnum.Active)
            {
                <span>Active</span>
            }
            else if (item.StatusId == (long)DBStatusEnum.InActive)
            {
                <span>In-Active</span>
            }
            else if (item.StatusId == (long)DBStatusEnum.Deleted)
            {
                <span>Deleted</span>
            }*@
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Message)
                        </td>
                        <td>
                            @*@Html.DisplayFor(modelItem => item.NotificationType)*@
                            @if (item.NotificationType == (long)NotificationTypeEnum.Product)
                            {
                                <span>Product</span>;
                            }
                            @if (item.NotificationType == (long)NotificationTypeEnum.Shop)
                            {
                                <span>Shop</span>;
                            }
                            @if (item.NotificationType == (long)NotificationTypeEnum.Order)
                            {
                                <span>Order</span>
                            }
                        </td>

                    </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
