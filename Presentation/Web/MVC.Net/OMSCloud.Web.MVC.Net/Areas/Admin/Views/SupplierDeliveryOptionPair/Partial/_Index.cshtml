@model IEnumerable<OMSCloud.Contracts.ViewModels.SupplierDeliveryOptionPairModel>

    <table class="table table-striped table-hover table-responsive table-bordered dataTable" style="width:100%">
        <thead>
            <tr>
                <th class="hidden">
                    @Html.DisplayNameFor(model => model.SupplierDeliveryOptionPairID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.SupplierName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.DeliveryOptionTitle)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.DeliveryCharges)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.MinOrderLimit)
                </th>
                <th class="hidden">
                    @Html.DisplayNameFor(model => model.SurroundingCities)
                </th>
                <th class="hidden"></th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="hidden">
                            @Html.DisplayFor(modelItem => item.SupplierDeliveryOptionPairID)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.SupplierName)
                        </td>
                        <td>
                            <a href="@Url.Action("Edit", new { id = item.SupplierDeliveryOptionPairID })" 
                               class="btn btn-sm btn-default" 
                               data-toggle="tooltip" 
                               data-placement="top" 
                               title="Edit">
                                <i class="glyphicon glyphicon-pencil">
                                    @Html.DisplayFor(modelItem => item.DeliveryOptionTitle)
                                </i>
                            </a>

                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.DeliveryCharges)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.MinOrderLimit)
                        </td>
                        <td class="hidden">
                            @Html.DisplayFor(modelItem => item.SurroundingCitiesIDs)
                        </td>
                        <td class="hidden">
                            <a href="@Url.Action("Edit", new { id = item.SupplierDeliveryOptionPairID })" class="btn btn-xs btn-default" data-toggle="tooltip" data-placement="top" title="Edit"><i class="glyphicon glyphicon-pencil"></i></a>
                            @*<a href="@Url.Action("Details", new { id = item.SupplierDeliveryOptionPairID })" class="btn btn-xs btn-info" data-toggle="tooltip" data-placement="top" title="Details"><i class="glyphicon glyphicon-eye-open"></i></a>
                                <a href="@Url.Action("Delete", new { id = item.SupplierDeliveryOptionPairID })" class="btn btn-xs btn-danger" data-toggle="tooltip" data-placement="top" title="Delete"><i class="glyphicon glyphicon-remove-sign"></i></a>*@
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
