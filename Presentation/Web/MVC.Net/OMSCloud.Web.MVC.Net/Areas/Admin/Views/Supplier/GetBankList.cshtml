@model IEnumerable<OMSCloud.Contracts.ViewModels.BankAccountModel>
@using OMSCloud.Contracts.Common.DBEnums

@{
    ViewBag.Title = "Bank List";
}
<div class="panel panel-default">
    <div class="panel-heading">
        <div class="hidden">
            <a href="@Url.Action("Create")" class="btn btn-md btn-default"><i class="glyphicon glyphicon-plus"></i> Create New</a>
        </div>
    </div>
    <div class="panel-body">
        <table class="table table-striped table-hover table-responsive table-bordered dataTable" style="width:100%">
            <thead>
                <tr>
                    <th class="hidden">
                        @Html.DisplayNameFor(model => model.RequestedByProfileId)
                    </th>
                    <th class="hidden">
                        @Html.DisplayNameFor(model => model.BankId)
                    </th>
                    <th class="hidden">
                        @Html.DisplayNameFor(model => model.SupplierId)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ShopName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Name)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Address)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.AccountTitle)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.IBAN)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.AccountNumber)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.AccountType)
                    </th>
                    <th class="hidden">actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="hidden">
                                @Html.DisplayFor(modelItem => item.RequestedByProfileId)
                            </td>
                            <td class="hidden">
                                @Html.DisplayFor(modelItem => item.BankId)
                            </td>
                            <td class="hidden">
                                @Html.DisplayFor(modelItem => item.SupplierId)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ShopName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Name)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Address)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.AccountTitle)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.IBAN)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.AccountNumber)
                            </td>
                            <td>
                                
                                @if (item.AccountTypeId == (long)BankAccountTypeEnum.BusinessChequing)
                                {
                                <span>BusinessChequing</span>
                                }
                                else if (item.AccountTypeId == (long)BankAccountTypeEnum.BusinessSaving)
                                {
                            <span>BusinessSaving</span>
                                }
                                else if (item.AccountTypeId == (long)BankAccountTypeEnum.PersonalChequing)
                                {
                            <span>PersonalChequing</span>
                                }
                                else if (item.AccountTypeId == (long)BankAccountTypeEnum.PersonalSaving)
                                {
                            <span>PersonalSaving</span>
                                }
                                else if (item.AccountTypeId == (long)BankAccountTypeEnum.None)
                                {
                            <span>None - N/A</span>
                                }
                                else
                                {
                            <span>None - N/A</span>
                                }
                            </td>
                            <td class="hidden">
                                @*@Html.ActionLink("Edit", "Edit", new { /* id=item.PrimaryKey */ }) |
                                @Html.ActionLink("Details", "Details", new { /* id=item.PrimaryKey */ }) |
                                @Html.ActionLink("Delete", "Delete", new { /* id=item.PrimaryKey */ })*@
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
