@model IEnumerable<OMSCloud.Contracts.ViewModels.AttributeModel>

@{
    ViewBag.Title = "Attribute List";
}
<div class="panel panel-default">
    <div class="panel-heading">
        <p>
            @*@Html.ActionLink("Create New", "Create")*@
            <a href="@Url.Action("Create")" class="btn btn-md btn-default"><i class="glyphicon glyphicon-plus"></i> Create New</a>
        </p>
    </div>
    <div class="panel-body">
        <div class="row">
            <div class="col-md-12">
                <form class="pull-right form-inline" method="get" action="/Admin/Attribute/Index">
                    <div class="form-group">
                        <input type="text" class="form-control input-sm" placeholder="Search Attribute" value="@ViewBag.SearchString" name="searchString">
                    </div>
                    <button type="submit" class="btn btn-default btn-sm">Submit</button>
                </form>
            </div>   <br /><br />
            <div class="col-md-12">
                <table class="table table-striped table-responsive table-hover table-bordered " style="width:100%">
                    <thead>
                        <tr>
                            <th class="hidden">
                                @Html.DisplayNameFor(model => model.AttributeID)
                            </th>
                            <th>
                                @Html.ActionLink("Attribute", "Index", new { sortOrder = ViewBag.AttributeNameSortParm, searchString = ViewBag.SearchString }, new { @style = " color: #000;" })
                            </th>
                            <th>
                                @Html.ActionLink("Description", "Index", new { sortOrder = ViewBag.DescriptionSortParm, searchString = ViewBag.SearchString }, new { @style = " color: #000;" })
                            </th>
                            <th>
                                @Html.ActionLink("Data Type", "Index", new { sortOrder = ViewBag.DataTypeSortParm, searchString = ViewBag.SearchString }, new { @style = " color: #000;" })
                            </th>
                            <th>
                                @Html.ActionLink("Attribute Type", "Index", new { sortOrder = ViewBag.AttributeTypeSortParm, searchString = ViewBag.SearchString }, new { @style = " color: #000;" })
                            </th>
                            <th>
                                @Html.ActionLink("IsMultiSelect", "Index", new { sortOrder = ViewBag.IsMultiSelectSortParm, searchString = ViewBag.SearchString }, new { @style = " color: #000;" })                                
                            </th>
                            <th>
                                @Html.ActionLink("IsSystem", "Index", new { sortOrder = ViewBag.IsSystemSortParm, searchString = ViewBag.SearchString }, new { @style = " color: #000;" })
                            </th>
                            <th>
                                @Html.ActionLink("Status", "Index", new { sortOrder = ViewBag.StatusSortParm, searchString = ViewBag.SearchString }, new { @style = " color: #000;" })
                            </th>
                            @*<th></th>*@
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="hidden">
                                        @Html.DisplayFor(modelItem => item.AttributeID)
                                    </td>
                                    <td>
                                        <a href="@Url.Action("Edit", new { id = item.AttributeID })" class="btn btn-md btn-default" data-toggle="tooltip" data-placement="top" title="Edit"><i class="glyphicon glyphicon-pencil"></i>@Html.DisplayFor(modelItem => item.AttributeTitle)</a>

                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Description)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.DataTypeTitle)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(model => item.AttributeTypeTitle)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(model => item.IsMultiSelect)
                                    </td>

                                    <td>
                                        @Html.DisplayFor(modelItem => item.IsSystem)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.StatusTitle)
                                    </td>
                                    @*<td>
                        <a href="@Url.Action("Details", new { id = item.AttributeID })" class="btn btn-xs btn-info" data-toggle="tooltip" data-placement="top" title="Details"><i class="glyphicon glyphicon-eye-open"></i></a>
                        <a href="@Url.Action("Delete", new { id = item.AttributeID })" class="btn btn-xs btn-danger" data-toggle="tooltip" data-placement="top" title="Delete"><i class="glyphicon glyphicon-remove-sign"></i></a>
                    </td>*@
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="7">There is no record to show</td></tr>
                        }
                    </tbody>
                </table>
                <ul class="pagination pull-right">
                    @if (ViewBag.CurrentPageIndex > 1)
                    {
                        <li>
                            <a href="/Admin/Attribute/Index?PageNum=1&searchString=@ViewBag.SearchString&sortOrder=@ViewBag.SortOrder" class="edge">|&lt;</a>
                        </li>
                        <li>
                            <a href="/Admin/Attribute/Index?PageNum=@(ViewBag.CurrentPageIndex - 1)&searchString=@ViewBag.SearchString&sortOrder=@ViewBag.SortOrder" class="edge">&lt;</a>
                        </li>
                    }
                    @{
                        var DISPLAY_PAGES = 6;
                        var startIdx = (ViewBag.CurrentPageIndex - DISPLAY_PAGES) < 0 ? 1 : (ViewBag.CurrentPageIndex < ViewBag.PageCount) ? ViewBag.CurrentPageIndex - (DISPLAY_PAGES - 2) : ViewBag.CurrentPageIndex - (DISPLAY_PAGES - 1);
                        var endIdx = (startIdx + DISPLAY_PAGES) - 1 > ViewBag.PageCount ? ViewBag.PageCount : (startIdx + DISPLAY_PAGES) - 1;

                        for (var i = startIdx; i <= endIdx; i++)
                        {
                            if (i != ViewBag.CurrentPageIndex)
                            {
                                <li><a href="/Admin/Attribute/Index?PageNum=@i&searchString=@ViewBag.SearchString&sortOrder=@ViewBag.SortOrder">@i</a></li>
                            }
                            else
                            {
                                <li><span class="active">@i</span></li>
                            }
                        }
                    }
                    @if (ViewBag.CurrentPageIndex < ViewBag.PageCount)
                    {
                        <li>
                            <a href="/Admin/Attribute/Index?PageNum=@(ViewBag.CurrentPageIndex + 1)&searchString=@ViewBag.SearchString&sortOrder=@ViewBag.SortOrder" class="edge">&gt;</a>
                        </li>
                        <li>
                            <a href="/Admin/Attribute/Index?PageNum=@(ViewBag.PageCount)&searchString=@ViewBag.SearchString&sortOrder=@ViewBag.SortOrder" class="edge">&gt;|</a>
                        </li>
                    }

                </ul>

            </div>
        </div>
    </div>
</div> 