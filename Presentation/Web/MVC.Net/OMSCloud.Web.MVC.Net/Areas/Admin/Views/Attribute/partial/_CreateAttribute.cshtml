@model OMSCloud.Contracts.ViewModels.AttributeModel

<div>
    <form id="myForm">
        <div class="form-horizontal">

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="form-group hidden">
                @Html.LabelFor(model => model.AttributeID, htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-10">
                    @Html.EditorFor(model => model.AttributeID, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.AttributeID, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.AttributeTitle, htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-8">
                    @Html.EditorFor(model => model.AttributeTitle, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.AttributeTitle, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.AttributeTypeTitle, htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-8">
                    @Html.DropDownListFor(model => model.AttributeTypeID, ViewBag.attributeType as SelectList, "--Select Attribute Type--", new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.AttributeTypeID, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-8">
                    @Html.EditorFor(model => model.Description, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.DataTypeTitle, htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-8">
                    @Html.DropDownListFor(model => model.DataTypeID, ViewBag.DataTypeList as SelectList, "--Select DataType--", new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.DataTypeID, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.DataTypeSize, htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-8">
                    @Html.EditorFor(model => model.DataTypeSize, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.DataTypeSize, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.DefaultValue, htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-8">
                    @Html.EditorFor(model => model.DefaultValue, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.DefaultValue, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.StatusTitle, htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-8">
                    @Html.DropDownListFor(model => model.StatusID, ViewBag.status as SelectList, "--Select status--", new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.StatusID, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.IsSystem, htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-8">
                    <div class="checkbox col-md-8">
                        @Html.EditorFor(model => model.IsSystem, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.IsSystem, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.IsMandatory, htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-8">
                    <div class="checkbox col-md-8">
                        @Html.EditorFor(model => model.IsMandatory, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.IsMandatory, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.IsMultiSelect, htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-8">
                    <div class="checkbox col-md-8">
                        @Html.EditorFor(model => model.IsMultiSelect, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.IsMultiSelect, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-offset-2 col-md-8">
                    <a href="#" id="btnSubmit" class="btn btn-success btn-block">Create New Attribute</a>
                </div>
            </div>

            <div style="text-align:center;display:none" id="loaderDiv">
                <img src="~/Areas/Admin/Contents/assets/images/loading_animation.gif" width="150" />
            </div>

        </div>
    </form>
</div>

<script>
    $(document).ready(function () {

        $("#btnSubmit").click(function () {

            $("#loaderDiv").show();

            var form = $('#__AjaxAntiForgeryForm');
            var token = $('input[name="__RequestVerificationToken"]', form).val();

            var myformdata = $("#myForm").serialize();
            myformdata = myformdata + "&__RequestVerificationToken=" + token

            $.ajax({
                type: "POST",
                url: "/Admin/Attribute/CreateAttribute/@ViewContext.RouteData.Values["id"].ToString()",
                data: myformdata,
                success: function(newAttribute) {
                    $("#loaderDiv").hide();
                    $("#attributeCreateModal").modal("hide");
                    OnModalClose(newAttribute);
                }
            })
        })
    })


    </script>


