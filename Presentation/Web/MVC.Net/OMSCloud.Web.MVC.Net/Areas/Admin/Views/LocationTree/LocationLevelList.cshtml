@model IEnumerable<OMSCloud.Contracts.ViewModels.LocationLevelModel>


@{
    ViewBag.Title = "Location Level List";
}
<div class="panel panel-default">
    <div class="panel-heading">
        <div class="hidden">
            <a href="@Url.Action("Create")" class="btn btn-md btn-default"><i class="glyphicon glyphicon-plus"></i> Create New</a>
        </div>
    </div>
    <div class="panel-body">
        <table class="table table-striped table-hover table-responsive table-bordered dataTable" style="width:100%">
            <thead>
                <tr>
                    <th class="hidden">
                        @Html.DisplayNameFor(model => model.RequestedByProfileId)
                    </th>
                    <th class="hidden">
                        @Html.DisplayNameFor(model => model.LocationLevelID)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.LocationLevelTitle)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Description)
                    </th>
                    <th class="hidden"></th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="hidden">
                                @Html.DisplayFor(modelItem => item.RequestedByProfileId)
                            </td>
                            <td class="hidden">
                                @Html.DisplayFor(modelItem => item.LocationLevelID)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.LocationLevelTitle)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Description)
                            </td>
                            <td class="hidden">
                                @Html.ActionLink("Edit", "Edit", new { /* id=item.LocationLevelID */ }) |
                                @Html.ActionLink("Details", "Details", new { /* id=item.LocationLevelID */ }) |
                                @Html.ActionLink("Delete", "Delete", new { /* id=item.LocationLevelID */ })
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
