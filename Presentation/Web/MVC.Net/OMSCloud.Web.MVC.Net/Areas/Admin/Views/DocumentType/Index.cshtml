@model IEnumerable<OMSCloud.Contracts.ViewModels.DocumentTypeModel>

@{
    ViewBag.Title = "Document Type List";
}
<div class="panel panel-default">
    <div class="panel-heading">
        <a href="@Url.Action("Create")" class="btn btn-md btn-default"><i class="glyphicon glyphicon-plus"></i> Create New</a>
    </div>
    <div class="panel-body">
        <table class="table table-striped  table-hover table-responsive table-bordered dataTable" style="width:100%">
            <thead>
                <tr>
                    <th hidden>
                        @Html.DisplayNameFor(model => model.RequestedByProfileId)
                    </th>
                    <th hidden>
                        @Html.DisplayNameFor(model => model.DocumentTypeID)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DocumentTypeTitle)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Description)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.IsSystem)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    foreach (var item in Model)
                    {
                    <tr>
                        <td hidden>
                            @Html.DisplayFor(modelItem => item.RequestedByProfileId)
                        </td>
                        <td hidden>
                            @Html.DisplayFor(modelItem => item.DocumentTypeID)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.DocumentTypeTitle)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Description)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.IsSystem)
                        </td>
                        <td>
                            <a href="@Url.Action("Edit", new { id = item.DocumentTypeID })" class="btn btn-xs btn-default" data-toggle="tooltip" data-placement="top" title="Edit"><i class="glyphicon glyphicon-pencil"></i></a>
                            @*<a href="@Url.Action("Details", new { id = item.DocumentTypeID })" class="btn btn-xs btn-info" data-toggle="tooltip" data-placement="top" title="Details"><i class="glyphicon glyphicon-eye-open"></i></a>
                            <a href="@Url.Action("Delete", new { id = item.DocumentTypeID })" class="btn btn-xs btn-danger" data-toggle="tooltip" data-placement="top" title="Delete"><i class="glyphicon glyphicon-remove-sign"></i></a>*@
                        </td>
                    </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
