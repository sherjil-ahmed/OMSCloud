@model IEnumerable<OMSCloud.Contracts.ViewModels.ProductViewItemModel>

@{
    ViewBag.Title = "ProductView-Item List";

}
<p>
    @*@Html.ActionLink("Create New", "Create")*@
    <a href="@Url.Action("Create")" class="btn btn-md btn-default"><i class="glyphicon glyphicon-plus"></i> Create New</a>
</p>
<table class="table table-striped table-responsive table-bordered dataTable" style="width:100%">
    <thead>
        <tr>
            <th hidden>
                @Html.DisplayNameFor(model => model.ProductViewProductID)
            </th>
            <th hidden>
                @Html.DisplayNameFor(model => model.ProductViewID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProductViewName)
            </th>
            <th hidden>
                @Html.DisplayNameFor(model => model.ProductID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProductName)
            </th>
            <th hidden>
                @Html.DisplayNameFor(model => model.ProductMediaID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProductMediaName)
            </th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null)
        {
            foreach (var item in Model)
            {
            <tr>
                <td hidden>
                    @Html.DisplayFor(modelItem => item.ProductViewProductID)
                </td>
                <td hidden>
                    @Html.DisplayFor(modelItem => item.ProductViewID)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ProductViewName)
                </td>
                <td hidden>
                    @Html.DisplayFor(modelItem => item.ProductID)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ProductName)
                </td>
                <td hidden>
                    @Html.DisplayFor(modelItem => item.ProductMediaID)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ProductMediaName)
                </td>
                <td>
                    @*@Html.ActionLink("Edit", "Edit", new { id = item.ProductViewProductID }) |
                    @Html.ActionLink("Details", "Details", new { id = item.ProductViewProductID }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.ProductViewProductID })*@
                    <a href="@Url.Action("Edit", new { id = item.ProductViewProductID })" class="btn btn-xs btn-default" data-toggle="tooltip" data-placement="top" title="Edit"><i class="glyphicon glyphicon-pencil"></i></a>
                    <a href="@Url.Action("Details", new { id = item.ProductViewProductID })" class="btn btn-xs btn-info" data-toggle="tooltip" data-placement="top" title="Details"><i class="glyphicon glyphicon-eye-open"></i></a>
                    <a href="@Url.Action("Delete", new { id = item.ProductViewProductID })" class="btn btn-xs btn-danger" data-toggle="tooltip" data-placement="top" title="Delete"><i class="glyphicon glyphicon-remove-sign"></i></a>
                </td>
            </tr>
            }
        }
    </tbody>

</table>
