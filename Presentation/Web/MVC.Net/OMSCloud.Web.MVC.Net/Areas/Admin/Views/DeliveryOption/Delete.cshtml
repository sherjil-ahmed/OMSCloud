@model OMSCloud.Contracts.ViewModels.DeliveryOptionModel

@{
    ViewBag.Title = "Delivery-Option Delete";

}

<script>

    function onDelete(Id, IsSystem)
    {
        event.preventDefault();
        ShowModal();
    }
</script>
<div class="panel panel-default">
    <div class="panel-body">
        <div>
            <dl class="dl-horizontal">
                <dt class="hidden">
                    @Html.DisplayNameFor(model => model.DeliveryOptionID)
                </dt>

                <dd class="hidden">
                    @Html.DisplayFor(model => model.DeliveryOptionID)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.DeliveryOptionTitle)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.DeliveryOptionTitle)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.Description)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.Description)
                </dd>

            </dl>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-actions no-color">
                    <input type="submit" value="Delete" class="btn btn-danger" onclick="onDelete(@Model.DeliveryOptionID)" />
                    <br />
                    <br />
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-success" })
                </div>
            }
        </div>
        @Html.Partial("../partial/DeleteModal", new ViewDataDictionary() {
                { "Title", "Delete"},
                { "modalDivId", "DeleteModal"},
                { "modalBodyId", "DeleteModalBody"},
                { "URL", "/Admin/DeliveryOption/Delete/" + Model.DeliveryOptionID.ToString()}
            })
    </div>
</div>
