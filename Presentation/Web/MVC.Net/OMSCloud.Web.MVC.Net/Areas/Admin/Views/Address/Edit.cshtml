@model OMSCloud.Contracts.ViewModels.AddressViewModel
@using OMSCloud.Contracts.ViewModels
@{
    ViewBag.Title = "Modify Address";
}
<div class="panel panel-default">
    <div class="panel-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })


                @{
                    Html.RenderPartial("_AddressInputPartial", new AddressViewModel()
                    {
                        ProfileID = Model.ProfileID,
                        OperatingCountryID = Model.OperatingCountryID,
                        OperatingProvinceID = Model.OperatingProvinceID,
                        OperatingCityID = Model.OperatingCityID,
                        
                        LocationID = Model.LocationID,
                        AddressID = Model.AddressID,
                        ProfileName = Model.ProfileName,
                        AddressTypeID = Model.AddressTypeID,
                        AddressTypeName = Model.AddressTypeName,
                        PlotNumber = Model.PlotNumber,
                        StreetNumber = Model.StreetNumber,
                        NearestLandmark = Model.NearestLandmark,
                        PostalCode = Model.PostalCode,
                        MapLink = Model.MapLink,
                        AddressModifiedOn = Model.AddressModifiedOn
                    });
                }
                <div class="form-group">
                    <div class="col-md-offset-2 col-md-6">
                        <input type="submit" value="Update" class="btn btn-success" />
                    </div>
                </div>

            </div>
        }
    </div>
</div>
<div>
    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-success" })
</div>
