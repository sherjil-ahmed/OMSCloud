@model OMSCloud.Contracts.ViewModels.AddressViewModel
@{
    ViewBag.Title = "Address Delete";
}
<script>
    
    function onDelete(Id, IsSystem)
    {
        event.preventDefault();
        ShowModal();
    }
</script>
