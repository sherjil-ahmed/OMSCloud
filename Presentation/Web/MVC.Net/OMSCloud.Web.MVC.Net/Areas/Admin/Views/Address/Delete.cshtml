                <dt>
                    @Html.DisplayNameFor(model => model.PostalCode)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.PostalCode)
                </dd>
            </dl>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                @*<div class="form-actions no-color">
                        <input type="submit" value="Delete" class="btn btn-success" />
                    </div>*@
                <div class="form-actions no-color">
                    @* @Html.ActionLink("Delete","Address", new { Id = Model.AddressID})*@
                    <input type="submit" value="Delete" class="btn btn-danger" onclick="onDelete(@Model.AddressID)" />
                </div>
            }
        </div>
    </div>
    @Html.Partial("../partial/DeleteModal", new ViewDataDictionary() {
                { "Title", "Delete"},
                { "modalDivId", "DeleteModal"},
                { "modalBodyId", "DeleteModalBody"},
                { "URL", "/Admin/Address/Delete/" + Model.AddressID.ToString()}
            })
</div>
<div>
    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-success" })
</div>