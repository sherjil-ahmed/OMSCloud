@model IEnumerable<OMSCloud.Contracts.ViewModels.AddressViewModel>
@{
    ViewBag.Title = "Address List";
}
<div class="panel panel-default">
    <div class="panel-heading">
        <a href="@Url.Action("Create")" class="btn btn-md btn-default"><i class="glyphicon glyphicon-plus"></i> Create New</a>
    </div>
    <div class="panel-body">
            <table class="table table-striped table-responsive table-hover table-bordered dataTable" style="width:100%">
                <thead>
                    <tr>
                        <th hidden>
                            @Html.DisplayNameFor(model => model.AddressID)
                        </th>
                        <th hidden>
                            @Html.DisplayNameFor(model => model.ProfileID)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.ProfileName)
                        </th>
                        <th hidden>
                            @Html.DisplayNameFor(model => model.AddressTypeID)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.AddressTypeName)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.PlotNumber)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.StreetNumber)
                        </th>
                        <th hidden>
                            @Html.DisplayNameFor(model => model.LocationID)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.NearestLandmark)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.LocationName)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.PostalCode)
                        </th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                    <tr>
                        <td hidden>
                            @Html.DisplayFor(modelItem => item.AddressID)
                        </td>
                        <td hidden>
                            @Html.DisplayFor(modelItem => item.ProfileID)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.ProfileName)
                        </td>
                        <td hidden>
                            @Html.DisplayFor(modelItem => item.AddressTypeID)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.AddressTypeName)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.PlotNumber)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.StreetNumber)
                        </td>
                        <td hidden>
                            @Html.DisplayFor(modelItem => item.LocationID)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.NearestLandmark)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.LocationName)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.PostalCode)
                        </td>
                        <td>
                            @*@Html.ActionLink("Edit", "Edit", new { id = item.AddressID }) |
            @Html.ActionLink("Details", "Details", new { id = item.AddressID }) |
            @Html.ActionLink("Delete", "Delete", new { id = item.AddressID })*@
                            @*  @{
                if (item.IsEditable)
                {
                    <button href="@Url.Action("Edit", new { id = item.AddressID })" disabled class="btn btn-xs btn-default" data-toggle="tooltip" data-placement="top" title="Edit"><i class="glyphicon glyphicon-pencil"></i></button>
                    <a href="@Url.Action("Details", new { id = item.AddressID })" class="btn btn-xs btn-info" data-toggle="tooltip" data-placement="top" title="Details"><i class="glyphicon glyphicon-eye-open"></i></a>
                    <button href="@Url.Action("Delete", new { id = item.AddressID })" disabled class="btn btn-xs btn-danger" data-toggle="tooltip" data-placement="top" title="Delete"><i class="glyphicon glyphicon-remove-sign"></i></button>
                }
                else
                {
                    <a href="@Url.Action("Edit", new { id = item.AddressID })" class="btn btn-xs btn-default" data-toggle="tooltip" data-placement="top" title="Edit"><i class="glyphicon glyphicon-pencil"></i></a>
                    <a href="@Url.Action("Details", new { id = item.AddressID })" class="btn btn-xs btn-info" data-toggle="tooltip" data-placement="top" title="Details"><i class="glyphicon glyphicon-eye-open"></i></a>
                    <a href="@Url.Action("Delete", new { id = item.AddressID })" class="btn btn-xs btn-danger" data-toggle="tooltip" data-placement="top" title="Delete"><i class="glyphicon glyphicon-remove-sign"></i></a>
                }
            }
                            *@
                        </td>
                    </tr>
                                        }
                                    }
                </tbody>
            </table>
    </div>
</div>
