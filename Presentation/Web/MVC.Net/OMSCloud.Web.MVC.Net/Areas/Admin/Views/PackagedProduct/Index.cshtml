@model IEnumerable<OMSCloud.Contracts.ViewModels.PackagedProductModel>
@{
    ViewBag.Title = "Bundle-Product List";

}
<p>
    @*@Html.ActionLink("Create New", "Create")*@
    <a href="@Url.Action("Create")" class="btn btn-md btn-default"><i class="glyphicon glyphicon-plus"></i> Create New</a>
</p>
<table class="table table-striped table-bordered dataTable" style="width:100%">
 <thead>
     <tr>
         <th class="hidden">
             @Html.DisplayNameFor(model => model.PackageID)
         </th>
         <th>
             @Html.DisplayNameFor(model => model.ProductTitle)
         </th>
         <th>
             @Html.DisplayNameFor(model => model.ChildProductTitle)
         </th>
         <th>
             @Html.DisplayNameFor(model => model.Quantity)
         </th>
         <th>
             @Html.DisplayNameFor(model => model.IncludedByDefault)
         </th>
         <th>
             @Html.DisplayNameFor(model => model.PercentagePrice)
         </th>
         <th>
             @Html.DisplayNameFor(model => model.OtherDetails)
         </th>
         <th></th>
     </tr>
 </thead>
    <tbody>
        @if (Model != null)
        {

            foreach (var item in Model)
            {
                <tr>
                    <td class="hidden">
                        @Html.DisplayFor(modelItem => item.PackageID)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ProductTitle)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ChildProductTitle)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Quantity)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.IncludedByDefault)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.PercentagePrice)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.OtherDetails)
                    </td>
                    <td>
                        @*@Html.ActionLink("Edit", "Edit", new { id = item.PackageID }) |
                        @Html.ActionLink("Details", "Details", new { id = item.PackageID }) |
                        @Html.ActionLink("Delete", "Delete", new { id = item.PackageID })*@
                        <a href="@Url.Action("Edit", new { id = item.PackageID })" class="btn btn-xs btn-default" data-toggle="tooltip" data-placement="top" title="Edit"><i class="glyphicon glyphicon-pencil"></i></a>
                        <a href="@Url.Action("Details", new { id = item.PackageID })" class="btn btn-xs btn-info" data-toggle="tooltip" data-placement="top" title="Details"><i class="glyphicon glyphicon-eye-open"></i></a>
                        <a href="@Url.Action("Delete", new { id = item.PackageID })" class="btn btn-xs btn-danger" data-toggle="tooltip" data-placement="top" title="Delete"><i class="glyphicon glyphicon-remove-sign"></i></a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
