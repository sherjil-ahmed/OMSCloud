@model IEnumerable<OMSCloud.Contracts.ViewModels.ProfileVerificationModelForAdmin>
@{
    ViewBag.Title = "Verification Documents for All users";
}

<div class="panel panel-default">
    <div class="panel-heading">
        <p>
            @*@Html.ActionLink("Create New", "CreatePublic")*@
            <a href="@Url.Action("CreatePublic")" class="btn btn-md btn-default disabled" style="color: #ccc"><i class="glyphicon glyphicon-plus"></i> Create New</a>
        </p>
    </div>
    <div class="panel-body">
        <table class="table table-striped table-responsive table-hover table-bordered dataTable" style="width:100%">
            <thead>
                <tr>
                    <th class="hidden">
                        @Html.DisplayNameFor(model => model.VerificationID)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.FullName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DocumentTypeTitle)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Verified)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Comments)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.VerificationStatusTitle)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DocumentNumberByVerifier)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    foreach (var item in Model)
                    {
                    <tr>
                        <td class="hidden">
                            @Html.DisplayFor(modelItem => item.VerificationID)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.FullName)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.DocumentTypeTitle)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Verified)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Comments)
                        </td>
                        <td>
                            <a href="@Url.Action("EditAdmin", "ProfileVerification", new { id = item.VerificationID })" class="btn btn-xs btn-default" data-toggle="tooltip" data-placement="top" title="Edit">
                                <i class="glyphicon glyphicon-pencil"></i>@Html.DisplayFor(modelItem => item.VerificationStatusTitle)
                            </a>
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.DocumentNumberByVerifier)
                        </td>
                        <td>
                            <a href="@Url.Action("EditAdmin", "ProfileVerification", new { id = item.VerificationID })" class="btn btn-xs btn-default" data-toggle="tooltip" data-placement="top" title="Edit"><i class="glyphicon glyphicon-pencil"></i></a>
                            @*
                                @Html.ActionLink("Edit", "EditAdmin", new { id = item.VerificationID })
                                @Html.ActionLink("Details", "Details", new {  id=item.VerificationID  }) |
                                @Html.ActionLink("Delete", "Delete", new {  id=item.VerificationID  })
                                *@
                        </td>
                    </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
