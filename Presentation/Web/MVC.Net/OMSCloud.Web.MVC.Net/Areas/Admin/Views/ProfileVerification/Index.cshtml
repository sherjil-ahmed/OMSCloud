@model IEnumerable<OMSCloud.Contracts.ViewModels.ProfileVerificationModel>
@{
    ViewBag.Title = "Verification Documents List for All users";
}

<div class="panel panel-default">
    <div class="panel-heading">
        <a href="@Url.Action("Create")" class="btn btn-md btn-default"><i class="glyphicon glyphicon-plus"></i> Create New</a>
    </div>
    <div class="panel-body">
        <table class="table table-striped table-responsive table-bordered dataTable" style="width:100%">
            <thead>
                <tr>
                    <th class="hidden">
                        @Html.DisplayNameFor(model => model.VerificationID)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DocumentTypeTitle)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.VerifiedBy)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.VerifiedOn)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Comments)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.VerificationStatusTitle)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.FullName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DocumentNumberByUser)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DocumentNumberByVerifier)
                    </th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null)
                {
                    foreach (var item in Model)
                    {
                    <tr>
                        <td class="hidden">
                            @Html.DisplayFor(modelItem => item.VerificationID)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.DocumentTypeTitle)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.VerifiedBy)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.VerifiedOn)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Comments)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.VerificationStatusTitle)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.FullName)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.DocumentNumberByUser)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.DocumentNumberByVerifier)
                        </td>
                        <td>
                            @*@Html.ActionLink("Edit", "Edit", new { id=item.VerificationID  }) |
                                @Html.ActionLink("Details", "Details", new {  id=item.VerificationID  }) |
                                @Html.ActionLink("Delete", "Delete", new {  id=item.VerificationID  })*@
                            <a href="@Url.Action("Edit", new { id = item.VerificationID })" class="btn btn-xs btn-default" data-toggle="tooltip" data-placement="top" title="Edit"><i class="glyphicon glyphicon-pencil"></i></a>
                            <a href="@Url.Action("Details", new { id = item.VerificationID })" class="btn btn-xs btn-info" data-toggle="tooltip" data-placement="top" title="Details"><i class="glyphicon glyphicon-eye-open"></i></a>
                            <a href="@Url.Action("Delete", new { id = item.VerificationID })" class="btn btn-xs btn-danger" data-toggle="tooltip" data-placement="top" title="Delete"><i class="glyphicon glyphicon-remove-sign"></i></a>
                        </td>
                    </tr>
                    }
                }
            </tbody>

        </table>
    </div>
</div>