@model IEnumerable<OMSCloud.Contracts.ViewModels.DataTypeModel>

@{
    ViewBag.Title = "DataType List";
}
<div class="panel panel-default">
    <div class="panel-heading">
            @*@Html.ActionLink("Create New", "Create")*@
            <a href="@Url.Action("Create")" class="btn btn-md btn-default"><i class="glyphicon glyphicon-plus"></i> Create New</a>
    </div>

    <div class="panel-body">
        <table class="table table-striped  table-hover table-responsive  table-bordered dataTable" style="width:100%">
            <thead>
                <tr>
                    <th class="hidden">
                        @Html.DisplayNameFor(model => model.DataTypeID)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.AssemblyName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Namespace)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ClassName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.FriendlyName)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.IsSystem)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="hidden">
                                @Html.DisplayFor(modelItem => item.DataTypeID)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.AssemblyName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Namespace)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ClassName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.FriendlyName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.IsSystem)
                            </td>
                            <td>
                                <a href="@Url.Action("Edit", new { id = item.DataTypeID })" class="btn btn-xs btn-default" data-toggle="tooltip" data-placement="top" title="Edit"><i class="glyphicon glyphicon-pencil"></i></a>
                                @*<a href="@Url.Action("Details", new { id = item.DataTypeID })" class="btn btn-xs btn-info" data-toggle="tooltip" data-placement="top" title="Details"><i class="glyphicon glyphicon-eye-open"></i></a>
                                <a href="@Url.Action("Delete", new { id = item.DataTypeID })" class="btn btn-xs btn-danger" data-toggle="tooltip" data-placement="top" title="Delete"><i class="glyphicon glyphicon-remove-sign"></i></a>*@
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>