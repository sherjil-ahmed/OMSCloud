@model OMSCloud.Contracts.ViewModels.LocationModel

<script>
    //check which dropdown is changed
    function dropdownCheck(Action) {
        var countryId = $('#CountryDropDown').val();
        var provinceId = $('#ProvinceDropDown').val();
        var cityId = $('#CityDropDown').val();
        switch (Action) {
            case 'ProvinceList':
                return countryId
                break;
            case 'CityList':
                return provinceId
                break;
            case 'AreaList':
                return cityId
        }
    }
    //Add values in dropdown
    function AddValues(node, Action, result) {
        $.each(result[Action], (i) => {
            var optionhtml = '<option value="' + result[Action][i].LocationID + '">' + result[Action][i].LocationName + '</option>'
            $(`#${node}`).append(optionhtml)
        })
    }
    //Empty below dropdowns
    function refillDropDown(Action, result) {
        var optionhtml1 = '<option value="">--Please Select--</option>'
        switch (Action) {
            case 'ProvinceList':
                $("#ProvinceDropDown").empty()
                $("#ProvinceDropDown").append(optionhtml1)
                $("#CityDropDown").empty()
                $("#CityDropDown").append(optionhtml1)
                $("#AreaDropDown").empty()
                $("#AreaDropDown").append(optionhtml1)
                AddValues("ProvinceDropDown", Action, result)
                break;
            case 'CityList':
                $("#CityDropDown").empty()
                $("#CityDropDown").append(optionhtml1)
                $("#AreaDropDown").empty()
                $("#AreaDropDown").append(optionhtml1)
                AddValues("CityDropDown", Action, result)
                break;
            case 'AreaList':
                $("#AreaDropDown").empty()
                $("#AreaDropDown").append(optionhtml1)
                AddValues("AreaDropDown", Action, result)
                break;
        }
    }
    //fetching data
    function callJson(Action) {
        $.ajax({
            type: "GET",
            url: "/Admin/Location/" + Action + "/" + dropdownCheck(Action),
            success: (result) => {
                refillDropDown(Action, result)
            }
        })

    }
</script>


<div class="form-group">
    @Html.LabelFor(model => model.OperatingProvinceTitle, htmlAttributes: new { @class = "control-label col-md-2" })
    <div class="col-md-2">
        @Html.DropDownListFor(model => model.OperatingProvinceID, ViewBag.Provinces as SelectList, "--Please Select--", new { @class = "form-control", @id = "ProvinceDropDown", onchange = "callJson('CityList')" })
        @Html.ValidationMessageFor(model => model.OperatingProvinceID, "", new { @class = "text-danger" })
    </div>
    @Html.LabelFor(model => model.OperatingCityTitle, htmlAttributes: new { @class = "control-label col-md-2" })
    <div class="col-md-2">
        @Html.DropDownListFor(model => model.OperatingCityID, ViewBag.Cities as SelectList, "--Please Select--", new { @class = "form-control", @id = "CityDropDown", onchange = "callJson('AreaList')" })
        @Html.ValidationMessageFor(model => model.OperatingCityID, "", new { @class = "text-danger" })
    </div>
</div>
@Html.ValidationSummary(true, "", new { @class = "text-danger" })