@model IEnumerable<OMSCloud.Contracts.ViewModels.ProductViewModel>
@{
    ViewBag.Title = "ProductView List";

}
<div class="panel panel-default">
    <div class="panel-heading">
        @*@Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-md btn-default" })*@
        <a href="@Url.Action("Create")" class="btn btn-md btn-default"><i class="glyphicon glyphicon-plus"></i> Create New</a>
    </div>
    <div class="panel-body">
        <div class="">
            <table class="table table-striped table-responsive table-hover table-bordered dataTable" style="width:100%">
                <thead>
                    <tr>
                        <th class="hidden">
                            @Html.DisplayNameFor(model => model.ProductViewID)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.ProductViewTitle)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Description)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.StatusTitle)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.IsSystem)
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="hidden">
                                    @Html.DisplayFor(modelItem => item.ProductViewID)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ProductViewTitle)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Description)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.StatusTitle)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.IsSystem)
                                </td>
                                <td>
                                    @*@Html.ActionLink("Edit", "Edit", new { id = item.ProductViewID }) |
                                        @Html.ActionLink("Details", "Details", new { id = item.ProductViewID }) |
                                        @Html.ActionLink("Delete", "Delete", new { id = item.ProductViewID })*@
                                    <a href="@Url.Action("Edit", new { id = item.ProductViewID })" class="btn btn-xs btn-default" data-toggle="tooltip" data-placement="top" title="Edit"><i class="glyphicon glyphicon-pencil"></i></a>
                                    <a href="@Url.Action("Details", new { id = item.ProductViewID })" class="btn btn-xs btn-info" data-toggle="tooltip" data-placement="top" title="Details"><i class="glyphicon glyphicon-eye-open"></i></a>
                                    <a href="@Url.Action("Delete", new { id = item.ProductViewID })" class="btn btn-xs btn-danger" data-toggle="tooltip" data-placement="top" title="Delete"><i class="glyphicon glyphicon-remove-sign"></i></a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>
