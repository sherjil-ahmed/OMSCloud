@model OMSCloud.Contracts.ViewModels.ProductViewItemModel

<div class="form-horizontal">
    <h4>@ViewBag.title</h4>
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="form-group hidden">
        @Html.LabelFor(model => model.ProductViewProductID, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-6">
            @Html.EditorFor(model => model.ProductViewProductID, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.ProductViewProductID, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.ProductName, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-6" id="PID">
            @Html.DropDownListFor(model => model.ProductID, ViewBag.productName as SelectList, "--please select--", new { @class = "form-control", @onchange = "FillProductMedia()" })
            @Html.ValidationMessageFor(model => model.ProductID, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.ProductMediaName, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-6">
            @Html.DropDownListFor(model => model.ProductMediaID, new SelectList(Enumerable.Empty<SelectListItem>(), "productMediaId", "productMediaName"), "Please Select", new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.ProductMediaID, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-3">
            <a href="#" class="btn btn-success" onclick="AddNewRecord()">Create</a>
        </div>
    </div>
</div>
<script src="~/Scripts/jquery-3.1.1.min.js"></script>

<script>
    function FillProductMedia() {
        var productId = $('#ProductID').val();
        $.ajax({
            url: '/Admin/productView/FillProductMedia',
            type: "GET",
            dataType: "JSON",
            data: { ProductID: productId },
            success: function (productMediaItems) {
                $("#ProductMediaID").html(""); // clear before appending new list
                $.each(productMediaItems, function (i, productMedia) {
                    $("#ProductMediaID").append(
                        $('<option></option>').val(productMedia.ProductMediaID).html(productMedia.ProductMediaTitle));
                    
                });

            }

        });
    }
</script>

<script>
    function FillGrid() {
        var productId = $('#ProductID').val();
        $.ajax({
            url: '/Admin/productView/FillGridProductID',
            type: "GET",
            dataType: "JSON",
            data: { ProductID: productId },
            success: function (GridResult) {
                var row = ""
                $.each(GridResult, function (index, item) {
                    row += "<tr><td>" + item.ProductViewName + "</td><td>" + item.ProductName + "</td><td>" + item.ProductMediaName + "</td></tr>";
                });
                $("#GridView1").append(row);
            },
            error: function (result) {
                alert("Failed to perform the operation, Please retry.");
            }
        });
    }
    var AddNewRecord = function () {
        
        var productId = $('#ProductID').val();
        var productTitle = $("#ProductID option:selected").text();
        var productMediaID = $('#ProductMediaID').val();
        var productMediaTitle = $("#ProductMediaID option:selected").text();

        var form = $('#__AjaxAntiForgeryForm');
        var token = $('input[name="__RequestVerificationToken"]', form).val();

        var myData = {
            ProductID: productId,
            ProductMediaID: productMediaID,
            ProductViewID: @ViewContext.RouteData.Values["id"].ToString(),
            "__RequestVerificationToken": token
        }
        $.ajax({
            type: "POST",
            url: "/Admin/productView/insertNewRecord/",
            data: myData ,
            success: function (result) {
                if(result == undefined || result == "")
                {
                    alert('unable to associate Product View. Please retry.');
                    return;
                }
                else
                {
                    var row = "<tr><td hidden>0</td><td hidden>0</td><td hidden>ProductViewName</td><td hidden>0</td><td>" + productTitle + "</td><td hidden>0</td><td>" + productMediaTitle + "</td></tr>";
                    $("#prductViewIemsGrid").append(row);
                }
            }
        });
    }
</script>
