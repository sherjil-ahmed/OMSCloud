@model IEnumerable<OMSCloud.Contracts.ViewModels.OrderPaymentModel>

@{
    ViewBag.Title = "Index";
}

<div class="panel panel-default">
    <div class="panel-heading">
        <a href="@Url.Action("Create")" class="btn btn-md btn-default"><i class="glyphicon glyphicon-plus"></i> Create New</a>
    </div>
    <div class="panel-body">
        <table class="table table-striped table-hover table-responsive table-bordered dataTable" style="width:100%">
            <thead>
                <tr>
                    <th class="hidden">
                        @Html.DisplayNameFor(model => model.RequestedByProfileId)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.OrderPaymentID)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CartOrderID)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.PaymentID)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Amount)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.BillingAddressID)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    foreach (var item in Model)
                    {
                    <tr>
                        <td class="hidden">
                            @Html.DisplayFor(modelItem => item.RequestedByProfileId)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.OrderPaymentID)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.CartOrderID)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.PaymentID)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Amount)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.BillingAddressID)
                        </td>
                        <td>
                            @*@Html.ActionLink("Edit", "Edit", new { id = item.OrderPaymentID }) |
                                @Html.ActionLink("Details", "Details", new { id = item.OrderPaymentID }) |
                                @Html.ActionLink("Delete", "Delete", new { id = item.OrderPaymentID })*@
                            <a href="@Url.Action("Edit", new { id = item.OrderPaymentID })" class="btn btn-xs btn-default" data-toggle="tooltip" data-placement="top" title="Edit"><i class="glyphicon glyphicon-pencil"></i></a>
                            <a href="@Url.Action("Details", new { id = item.OrderPaymentID })" class="btn btn-xs btn-info" data-toggle="tooltip" data-placement="top" title="Details"><i class="glyphicon glyphicon-eye-open"></i></a>
                            <a href="@Url.Action("Delete", new { id = item.OrderPaymentID })" class="btn btn-xs btn-danger" data-toggle="tooltip" data-placement="top" title="Delete"><i class="glyphicon glyphicon-remove-sign"></i></a>
                        </td>
                    </tr>
                    }
                }
            </tbody>
        </table>
    </div>
 </div>