@model IEnumerable<OMSCloud.Contracts.ViewModels.OrderStatusMapModel>

@{
    ViewBag.Title = "Order Status Map List";
}

<div class="panel panel-default">
    <div class="panel-heading">
        <a href="@Url.Action("Create")" class="btn btn-md btn-default"><i class="glyphicon glyphicon-plus"></i> Create New</a>
    </div>
    <div class="panel-body">
        <table class="table table-striped table-hover table-responsive table-bordered dataTable" style="width:100%">
            <thead>
                <tr @*style="background-color: ActiveCaption"*@>
                    <th class="hidden">
                        @Html.DisplayNameFor(model => model.RequestedByProfileId)
                    </th>
                    <th class="hidden">
                        @Html.DisplayNameFor(model => model.OrderStatusMapID)
                    </th>
                    <th class="hidden">
                        @Html.DisplayNameFor(model => model.ParentOrderStatusID)
                    </th>
                    <th class="hidden">
                        @Html.DisplayNameFor(model => model.ChildOrderStatusID)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ParentOrderStatusTitle)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.IsDefault)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ChildOrderStatusTitle)
                    </th>
                    <th class="hidden">
                        @Html.DisplayNameFor(model => model.StatusID)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.StatusTitle)
                    </th>
                    <th class="hidden">
                        @Html.DisplayNameFor(model => model.Description)
                    </th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null)
                {
                    foreach (var item in Model)
                    {
                            <tr>
                                <td class="hidden">
                                    @Html.DisplayFor(modelItem => item.RequestedByProfileId)
                                </td>
                                <td class="hidden">
                                    @Html.DisplayFor(modelItem => item.OrderStatusMapID)
                                </td>
                                <td class="hidden">
                                    @Html.DisplayFor(modelItem => item.ParentOrderStatusID)
                                </td>
                                <td class="hidden">
                                    @Html.DisplayFor(modelItem => item.ChildOrderStatusID)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ParentOrderStatusTitle)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.IsDefault)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ChildOrderStatusTitle)
                                </td>
                                <td class="hidden">
                                    @Html.DisplayFor(modelItem => item.StatusID)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.StatusTitle)
                                </td>
                                <td class="hidden">
                                    @Html.DisplayFor(modelItem => item.Description)
                                </td>
                                <td>
                                    <a href="@Url.Action("Edit", new { id = item.OrderStatusMapID })" class="btn btn-xs btn-default" data-toggle="tooltip" data-placement="top" title="Edit"><i class="glyphicon glyphicon-pencil"></i></a>
                                    @*<a href="@Url.Action("Details", new { id = item.OrderStatusMapID })" class="btn btn-xs btn-info" data-toggle="tooltip" data-placement="top" title="Details"><i class="glyphicon glyphicon-eye-open"></i></a>
                                    <a href="@Url.Action("Delete", new { id = item.OrderStatusMapID })" class="btn btn-xs btn-danger" data-toggle="tooltip" data-placement="top" title="Delete"><i class="glyphicon glyphicon-remove-sign"></i></a>*@
                                </td>
                            </tr>
                    }
                }
                </tbody>
        </table>
    </div>
</div>

