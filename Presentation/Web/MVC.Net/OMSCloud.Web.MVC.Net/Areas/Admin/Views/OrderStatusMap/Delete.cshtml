@model OMSCloud.Contracts.ViewModels.OrderStatusMapModel

@{
    ViewBag.Title = "Delete Order Status Map";
}
    <script>
        function onDelete(Id, IsSystem) {
            event.preventDefault();
            ShowModal();
        }
    </script>
<div class="panel panel-default">
    <div class="panel-body">

        <dl class="dl-horizontal">
            <dt class="hidden">
                @Html.DisplayNameFor(model => model.RequestedByProfileId)
            </dt>

            <dd class="hidden">
                @Html.DisplayFor(model => model.RequestedByProfileId)
            </dd>

            <dt class="hidden">
                @Html.DisplayNameFor(model => model.OrderStatusMapID)
            </dt>

            <dd class="hidden">
                @Html.DisplayFor(model => model.OrderStatusMapID)
            </dd>

            <dt>
                @Html.DisplayNameFor(model => model.ParentOrderStatusTitle)
            </dt>

            <dd>
                @Html.DisplayFor(model => model.ParentOrderStatusTitle)
            </dd>

            <dt>
                @Html.DisplayNameFor(model => model.ChildOrderStatusTitle)
            </dt>

            <dd>
                @Html.DisplayFor(model => model.ChildOrderStatusTitle)
            </dd>

            <dt>
                @Html.DisplayNameFor(model => model.StatusTitle)
            </dt>

            <dd>
                @Html.DisplayFor(model => model.StatusTitle)
            </dd>

            <dt>
                @Html.DisplayNameFor(model => model.Description)
            </dt>

            <dd>
                @Html.DisplayFor(model => model.Description)
            </dd>

        </dl>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-actions no-color">
                <input type="submit" value="Delete" class="btn btn-danger" onclick="onDelete(@Model.OrderStatusMapID)"/>
            </div>
        }

    </div>
</div>
<div>
    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-success" })

    @Html.Partial("../partial/DeleteModal", new ViewDataDictionary() {
                { "Title", "Delete"},
                { "modalDivId", "DeleteModal"},
                { "modalBodyId", "DeleteModalBody"},
                { "URL", "/Admin/OrderStatusMap/Delete/" + Model.OrderStatusMapID.ToString()}
            })
</div>